@FiniteGame.omegaQcPOVM_eq_one_of_perfect : ∀ {X : Type u_1} {Y : Type u_2} {A : Type u_3} {B : Type u_4}
  [inst : Fintype A] [inst_1 : Fintype B] [inst_2 : Fintype X] [inst_3 : Fintype Y] (G : FiniteGame X Y A B) {H : Type}
  [inst_4 : NormedAddCommGroup H] [inst_5 : InnerProductSpace ℂ H] [inst_6 : CompleteSpace H]
