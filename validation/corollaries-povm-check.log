@POVM.exists_projective_dilation : ∀ {H : Type u_1} {O : Type u_2} [inst : NormedAddCommGroup H]
  [inst_1 : InnerProductSpace ℂ H] [CompleteSpace H] [inst_3 : Fintype O] [FiniteDimensional ℂ H] [Nontrivial H]
  [Nonempty O] {X : Type u_3} (M : X → POVM H O),
  ∃ n,
    ∃ (_ : 0 < n),
      ∃ V P, ∀ (x : X) (a : O) (ξ ζ : H), inner ℂ (V ξ) (((P x).proj a) (V ζ)) = inner ℂ ξ (((M x).effect a) ζ)
@FinitePOVMStrategy.exists_projective : ∀ {X : Type u_1} {Y : Type u_2} {A : Type u_3} {B : Type u_4} [inst : Fintype A]
  [inst_1 : Fintype B] [Nonempty A] [Nonempty B] (S : FinitePOVMStrategy X Y A B), ∃ T, T.correlation = S.correlation
@FinitePOVMStrategy.exists_coordinates : ∀ {X : Type u_1} {Y : Type u_2} {A : Type u_3} {B : Type u_4} {H : Type u_5}
  {K : Type u_6} [inst : Fintype A] [inst_1 : Fintype B] [inst_2 : NormedAddCommGroup H]
  [inst_3 : InnerProductSpace ℂ H] [FiniteDimensional ℂ H] [inst_5 : NormedAddCommGroup K]
  [inst_6 : InnerProductSpace ℂ K] [FiniteDimensional ℂ K] (ψ : TensorProduct ℂ H K),
  ‖ψ‖ = 1 →
    ∀ (M : X → POVM H A) (N : Y → POVM K B),
      ∃ S, S.correlation = fun x y a b => (inner ℂ ψ ((TensorProduct.mapL ((M x).effect a) ((N y).effect b)) ψ)).re
