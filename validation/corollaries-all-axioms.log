ThomGame.Analysis.matrixMarkovDiagonalPower_internal_iff (dims : ℕ → ℕ) {h : ℕ} [NeZero h]
  (U : (n : ℕ) → Fin h → ↥(ThomGame.Analysis.UnitaryMatrix (dims n))) (hd : ∀ (n : ℕ), 0 < dims n) (L : Ultrafilter ℕ)
  (hL : ↑L ≤ Filter.atTop) (κ : ℝ) (hgap : ThomGame.Analysis.MatrixMarkovSpectralGap dims U hd L κ)
  (S : (n : ℕ) → StarSubalgebra ℂ (ThomGame.Analysis.CMatrix (dims n))) :
  ThomGame.Analysis.matrixInternalQuotient dims S ↑L = ThomGame.Analysis.matrixRelativeCommutant dims U ↑L ↔
    Filter.Tendsto
      (((ThomGame.Analysis.matrixUniformMarkovPower dims U hd
                (ThomGame.Analysis.matrixMarkovDiagonalPower dims U hd κ)).sub
            (ThomGame.Analysis.matrixUniformExpectation dims S hd)).coordinateMixedNorm
        hd)
      (↑L) (nhds 0)
ThomGame.Analysis.exists_matrixMarkovDiagonal_inducing_expectation (dims : ℕ → ℕ) {h : ℕ} [NeZero h]
  (U : (n : ℕ) → Fin h → ↥(ThomGame.Analysis.UnitaryMatrix (dims n))) (hd : ∀ (n : ℕ), 0 < dims n) (L : Ultrafilter ℕ)
  (hL : ↑L ≤ Filter.atTop) (κ : ℝ) (hgap : ThomGame.Analysis.MatrixMarkovSpectralGap dims U hd L κ) :
  ∃ ell,
    (∀ (n : ℕ), 0 < ell n) ∧
      Filter.Tendsto ell (↑L) Filter.atTop ∧
        (ThomGame.Analysis.matrixUniformMarkovPower dims U hd ell).quotientMap ↑L =
            ThomGame.Analysis.matrixRelativeExpectation dims U hd L hL ∧
          ∀ (k : ℕ → ℕ),
            Filter.Tendsto k (↑L) Filter.atTop →
              (∀ᶠ (n : ℕ) in ↑L, k n ≤ ell n) →
                (ThomGame.Analysis.matrixUniformMarkovPower dims U hd k).quotientMap ↑L =
                  ThomGame.Analysis.matrixRelativeExpectation dims U hd L hL
ThomGame.Analysis.matrixRelativeExpectation_poincare_sq {h : ℕ} [NeZero h] (dims : ℕ → ℕ)
  (U : (n : ℕ) → Fin h → ↥(ThomGame.Analysis.UnitaryMatrix (dims n))) (hd : ∀ (n : ℕ), 0 < dims n) (L : Ultrafilter ℕ)
  (hL : ↑L ≤ Filter.atTop) (κ : ℝ) (hgap : ThomGame.Analysis.MatrixMarkovSpectralGap dims U hd L κ)
  (x : ThomGame.Analysis.MatrixTracialQuotient dims ↑L) :
  κ *
      ‖(ThomGame.Analysis.matrixHilbertEmbedding dims hd L)
            (x - (ThomGame.Analysis.matrixRelativeExpectation dims U hd L hL) x)‖ ^
        2 ≤
    ThomGame.Analysis.matrixMarkovEnergy dims U hd L x
ThomGame.Analysis.matrixRelativeExpectation_poincare {h : ℕ} [NeZero h] (dims : ℕ → ℕ)
  (U : (n : ℕ) → Fin h → ↥(ThomGame.Analysis.UnitaryMatrix (dims n))) (hd : ∀ (n : ℕ), 0 < dims n) (L : Ultrafilter ℕ)
  (hL : ↑L ≤ Filter.atTop) (κ : ℝ) (hgap : ThomGame.Analysis.MatrixMarkovSpectralGap dims U hd L κ)
  (x : ThomGame.Analysis.MatrixTracialQuotient dims ↑L) :
  ‖(ThomGame.Analysis.matrixHilbertEmbedding dims hd L)
        (x - (ThomGame.Analysis.matrixRelativeExpectation dims U hd L hL) x)‖ ≤
    (√κ)⁻¹ * √(ThomGame.Analysis.matrixMarkovEnergy dims U hd L x)
