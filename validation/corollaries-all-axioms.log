  (i : ThomGame.Construction.WheelCycleIndex)
  (a : ThomGame.Pictures.PortGraph.RimDart H (ThomGame.Construction.numberedWheelCycles i)) (side : Bool)
  (m : ThomGame.Construction.GermSunRelabelling t i a side)
  (hw :
    List.map m.edge ((ThomGame.Construction.closedSigmaRimCircuit H i a).frontierWord !side) =
      ThomGame.Construction.closedSigmaRimSunFrontierWord H i a !side)
  {K :
    ThomGame.Pictures.PortGraph
      (ThomGame.Pictures.sunPresentation (ThomGame.Construction.wheelCycles i).length fun x => 0) []
      (List.map m.edge ((ThomGame.Construction.closedSigmaRimCircuit H i a).frontierWord !side)).reverse}
  (q : (ThomGame.Construction.germSunInitialGraph t i a side m).SunSwitchTrace K)
  (L :
    ThomGame.Construction.IncludedWheelSun i K
      ((ThomGame.Construction.closedSigmaRimCircuit H i a).frontierWord !side).reverse)
  (hp :
    ∀
