ThomGame.Pictures.RotationEuler.firstReturnRotation_saturated.{u_1} {D : Type u_1} [Finite D] [DecidableEq D]
  (r : Equiv.Perm D) (M : D → Prop) (t : Equiv.Perm D) (hM : ∀ (x : D), M (t x) ↔ M x) (ht : Function.Involutive ⇑t)
  (hEuler :
    ThomGame.Pictures.RotationEuler.count r t = 2 * ↑(Nat.card (ThomGame.Pictures.RibbonConnectivity.Component r t))) :
  ThomGame.Pictures.RotationEuler.count (ThomGame.Pictures.MarkedReturn.perm r M) (t.subtypePerm hM) =
    2 *
      ↑(Nat.card
          (ThomGame.Pictures.RibbonConnectivity.Component (ThomGame.Pictures.MarkedReturn.perm r M) (t.subtypePerm hM)))
