  (hf : f 0 = 0) : Matrix.rank (cfc f A) ≤ Matrix.rank A
ThomGame.Analysis.matrix_spectral_rounding_posPart_trace_le {d : ℕ} {A : ThomGame.Analysis.CMatrix d} (hA0 : 0 ≤ A)
  (hA1 : A ≤ 1) {s : ℝ} (hs : 0 ≤ s) :
  (ThomGame.Analysis.normalizedTrace (A - ThomGame.Analysis.matrixSpectralCut A s)⁺).re ≤ s * (↑(Matrix.rank A) / ↑d)
ThomGame.Analysis.matrixResolventSpectralProjection_rounding_sum_le {d : ℕ} {lam s : ℝ}
  {S₀ : ThomGame.Analysis.CMatrix d} (hlam : 0 < lam) (hS₀ : 0 ≤ S₀) (F : ℕ → ThomGame.Analysis.CMatrix d)
  (hF : ∀ (i : ℕ), IsStarProjection (F i)) (hs : 0 ≤ s) (n : ℕ) :
  ∑ i,
      (ThomGame.Analysis.normalizedTrace
          (ThomGame.Analysis.matrixResolventDifferenceFamily lam S₀ F ↑i -
              ThomGame.Analysis.matrixResolventSpectralProjection lam S₀ F s ↑i)⁺).re ≤
    s * ∑ i ∈ Finset.range n, (ThomGame.Analysis.normalizedTrace (F i)).re
ThomGame.Analysis.matrixResolventSpectralProjection_weighted_trace_sum_le {d : ℕ} {lam s : ℝ}
  {S₀ : ThomGame.Analysis.CMatrix d} (hlam : 0 < lam) (hS₀ : 0 ≤ S₀) (F : ℕ → ThomGame.Analysis.CMatrix d)
  (hF : ∀ (i : ℕ), IsStarProjection (F i)) (hs : 0 < s) (n : ℕ) :
  ∑ i,
      (ThomGame.Analysis.normalizedTrace
          (ThomGame.Analysis.matrixProjectionPartialSum S₀ F ↑i ^ 2 *
            ThomGame.Analysis.matrixResolventSpectralProjection lam S₀ F s ↑i)).re ≤
    s⁻¹ * lam * ∑ i ∈ Finset.range n, (ThomGame.Analysis.normalizedTrace (F i)).re
ThomGame.Analysis.matrixResolventSpectralProjection_coverage {d : ℕ} {γ s : ℝ} {P : ThomGame.Analysis.CMatrix d}
  [NeZero d] (hγ : 0 < γ) (hP : IsStarProjection P) (F : ℕ → ThomGame.Analysis.CMatrix d)
  (hF : ∀ (i : ℕ), IsStarProjection (F i)) (n : ℕ)
  (htrace : ∑ i ∈ Finset.range n, (ThomGame.Analysis.normalizedTrace (F i)).re ≤ 3) (hs : s ∈ Set.Icc γ (2 * γ)) :
  (ThomGame.Analysis.matrixFamilyCoverageDefect fun i =>
      ThomGame.Analysis.matrixResolventSpectralProjection (γ ^ 2) P F s ↑i) ≤
    (ThomGame.Analysis.normalizedTrace P).re +
        (ThomGame.Analysis.normalizedTrace
            (1 - ThomGame.Analysis.matrixSpectralCut (ThomGame.Analysis.matrixProjectionPartialSum P F n) γ)).re +
      7 * γ
ThomGame.Analysis.exists_matrixResolventSpectralRounding {d h : ℕ} [NeZero d] [NeZero h] {γ : ℝ}
  {P : ThomGame.Analysis.CMatrix d} (hγ : 0 < γ) (hP : IsStarProjection P) (F : ℕ → ThomGame.Analysis.CMatrix d)
  (hF : ∀ (i : ℕ), IsStarProjection (F i)) (n : ℕ)
  (htrace : ∑ i ∈ Finset.range n, (ThomGame.Analysis.normalizedTrace (F i)).re ≤ 3)
  (U : Fin h → ↥(ThomGame.Analysis.UnitaryMatrix d)) :
  ∃ s ∈ Set.Icc γ (2 * γ),
    (∀ (i : Fin n),
        IsStarProjection (ThomGame.Analysis.matrixResolventSpectralProjection (γ ^ 2) P F s ↑i) ∧
          Matrix.rank (ThomGame.Analysis.matrixResolventSpectralProjection (γ ^ 2) P F s ↑i) ≤ Matrix.rank (F ↑i)) ∧
      ∑ i,
            (ThomGame.Analysis.normalizedTrace
                (ThomGame.Analysis.matrixProjectionPartialSum P F ↑i ^ 2 *
                  ThomGame.Analysis.matrixResolventSpectralProjection (γ ^ 2) P F s ↑i)).re ≤
          3 * γ ∧
        (ThomGame.Analysis.matrixFamilyCoverageDefect fun i =>
              ThomGame.Analysis.matrixResolventSpectralProjection (γ ^ 2) P F s ↑i) ≤
            (ThomGame.Analysis.normalizedTrace P).re +
                (ThomGame.Analysis.normalizedTrace
                    (1 -
                      ThomGame.Analysis.matrixSpectralCut (ThomGame.Analysis.matrixProjectionPartialSum P F n) γ)).re +
              7 * γ ∧
          ∑ i,
              ThomGame.Analysis.matrixCoordinateEnergy U
                (ThomGame.Analysis.matrixResolventSpectralProjection (γ ^ 2) P F s ↑i) ≤
            √((∑ i,
                    ThomGame.Analysis.matrixCoordinateEnergy U
                      (ThomGame.Analysis.matrixResolventDifferenceFamily (γ ^ 2) P F ↑i)) /
                  (2 * γ)) /
              γ
