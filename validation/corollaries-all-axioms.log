ThomGame.Analysis.matrixPartitionScalarExpectation_eq_traceProjection.{u_1} {d : ℕ} {μ : Type u_1} [Fintype μ]
  [NeZero d] (E : μ → ThomGame.Analysis.CMatrix d) (hE : ∀ (i : μ), IsStarProjection (E i))
  (horth : Pairwise fun i j => E i * E j = 0) (hsum : ∑ i, E i = 1) (X : ThomGame.Analysis.CMatrix d) :
  ThomGame.Analysis.matrixPartitionScalarExpectation E X =
    (ThomGame.Analysis.matrixTraceProjection (ThomGame.Analysis.matrixPartitionScalarAlgebra E)) X
