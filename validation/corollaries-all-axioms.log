ThomGame.Construction.smoothedSigmaRim_exists_normalized_gluing {d : ThomGame.Construction.SigmaDiagram [] []}
  {H : ThomGame.Construction.SigmaGraph [] []} (t : ThomGame.Construction.SigmaGraphWitness d H) [IsEmpty H.Joint]
  (hmin : ThomGame.Pictures.Diagram.Minimal d) (hs : ThomGame.Pictures.Diagram.sign d = 1)
  (i : ThomGame.Construction.WheelCycleIndex)
  (a : ThomGame.Pictures.PortGraph.RimDart H (ThomGame.Construction.numberedWheelCycles i))
  (hi : i ≠ ThomGame.Construction.oddWheelCycle) :
  ∃ side e G cs _tSun K q L,
    e.Minimal ∧
      e.CharacterMinimal ∧
        IsEmpty G.Joint ∧
          ThomGame.Pictures.PortGraph.SunSwitchTrace.Inward ⋯ ⋯ q ∧
            ThomGame.Pictures.PortGraph.SunFaceState ⋯ ⋯ K ∧
              ∑ h, ↑[L.graph.hubLabel h] =
                  Multiset.map (⇑(ThomGame.Construction.numberedWheelSunEmbedding i).vertex)
                    (Multiset.filterMap (ThomGame.Construction.numberedWheelCycleRetraction i).retract.vertex
                      (∑ h, ↑[(ThomGame.Construction.smoothedSigmaRimGermGraph t i a side).hubLabel h])) ∧
                Fintype.card (L.glue (ThomGame.Construction.smoothedSigmaRimRegionGraph t i a !side)).graph.Hub =
                    ThomGame.Pictures.Diagram.size d ∧
                  (L.glue (ThomGame.Construction.smoothedSigmaRimRegionGraph t i a !side)).graph.sign = 1 ∧
                    ∃ f,
                      ↑(ThomGame.Pictures.Diagram.labels f) =
                          ∑ h,
                            ↑[(L.glue (ThomGame.Construction.smoothedSigmaRimRegionGraph t i a !side)).graph.hubLabel
                                  h] ∧
                        ThomGame.Pictures.Diagram.size f = ThomGame.Pictures.Diagram.size d ∧
                          ThomGame.Pictures.Diagram.sign f = 1 ∧ ThomGame.Pictures.Diagram.Minimal f
