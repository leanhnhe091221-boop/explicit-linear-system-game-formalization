ThomGame.Analysis.matrixProjection_trace_eq_rank {d : ℕ} {P : ThomGame.Analysis.CMatrix d} (hP : IsStarProjection P) :
  (ThomGame.Analysis.normalizedTrace P).re = ↑(Matrix.rank P) / ↑d
