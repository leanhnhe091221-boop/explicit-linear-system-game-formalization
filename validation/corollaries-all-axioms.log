ThomGame.Analysis.exists_matrixCompressionPolar.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι] (r : ℕ)
  {q : Matrix ι ι ℂ} (hq : IsStarProjection q) (u : ↥(Matrix.unitaryGroup ι ℂ)) :
  ∃ W,
    W.conjTranspose * W = q ∧
      W * W.conjTranspose = q ∧
        W.conjTranspose * (q * ↑u * q) = ThomGame.Analysis.matrixRectAbs (q * ↑u * q) ∧
          ThomGame.Analysis.rectHSNorm r (W - q * ↑u * q) ^ 2 ≤ ThomGame.Analysis.rectHSNorm r ((1 - q) * ↑u * q) ^ 2 ∧
            ThomGame.Analysis.rectHSNorm r (W - q * ↑u) ^ 2 ≤ ThomGame.Analysis.rectHSNorm r (↑u * q - q * ↑u) ^ 2 ∧
              ThomGame.Analysis.rectHSNorm r (↑u * q - W) ^ 2 ≤ ThomGame.Analysis.rectHSNorm r (↑u * q - q * ↑u) ^ 2
