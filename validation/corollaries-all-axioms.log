  (hn : 3 ≤ n) (hu : ∀ z ∈ u, ∃ j, z = Sum.inl j) (hv : ∀ z ∈ v, ∃ j, z = Sum.inl j) (s : G.SunSpoke)
  (hEuler : ThomGame.Pictures.RibbonConnectivity.eulerDefect G.pairing.perm G.circuitStep = 0)
  (hf : G.hubFlip s.left = G.hubFlip s.right) (hsees : G.BoundarySeesComponents)
  (hc :
    ThomGame.Pictures.RibbonConnectivity.Connected (G.sunRimPairing hn).perm (G.sunRimVertexPairing hn hu hv).perm
      (G.sunRimPort hn s.left true) (G.sunRimPort hn s.right true))
  (hOld : (s.leftRim hn hu hv).MeetsBoundary)
  (hi : (s.leftRim hn hu hv).OnSide (!(s.leftRim hn hu hv).boundarySide hOld) (ThomGame.Pictures.Port.hub s.left 0))
  (hL : (s.switchedSpoke.leftRim hn hu hv).MeetsBoundary) (hR : (s.switchedSpoke.rightRim hn hu hv).MeetsBoundary) :
