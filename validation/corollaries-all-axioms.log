def ThomGame.Pictures.PortGraph.RimDart.{u_1, u_2} : {R : Type u_1} →
  {S : Type u_2} →
    [inst : DecidableEq R] →
      [inst_1 : DecidableEq S] →
        {A : ThomGame.SparseSystem R S} →
          {u v : List S} → ThomGame.SolutionGroup.RowGraph A u v → A.hypergraph.Cycle → Type :=
fun {R} {S} [DecidableEq R] [DecidableEq S] {A} {u v} G C =>
  { a // ThomGame.Pictures.Port.label G.jointLabel a ∈ Set.range ⇑C.edge }
def ThomGame.Pictures.PortGraph.RimIncident.{u_1, u_2} : {R : Type u_1} →
