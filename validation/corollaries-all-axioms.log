ThomGame.Construction.SigmaMinimalState.exists_minimal_stellar_sun {H : ThomGame.Construction.SigmaGraph [] []}
  (h : ThomGame.Construction.SigmaMinimalState H) (i : ThomGame.Construction.WheelCycleIndex)
  (a : ThomGame.Pictures.PortGraph.RimDart H (ThomGame.Construction.numberedWheelCycles i))
  (hi : i ≠ ThomGame.Construction.oddWheelCycle) :
  ∃ s e,
    ↑e.labels =
        Multiset.filterMap (ThomGame.Construction.numberedWheelCycleRetraction i).retract.vertex
          (∑ x, ↑[(h.germGraph i a s).hubLabel x]) ∧
      e.size = Fintype.card (h.germGraph i a s).Hub ∧
        e.sign = 0 ∧ e.Minimal ∧ e.CharacterMinimal ∧ ThomGame.Pictures.PortGraph.sign (h.germGraph i a s) = 0
