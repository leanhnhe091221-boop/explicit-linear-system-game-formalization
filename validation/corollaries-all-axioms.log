  (hFi : F.conjTranspose * F = 1) (hFf : F * F.conjTranspose = q) (u : ↥(Matrix.unitaryGroup ι ℂ)) :
  ∃ v,
    ThomGame.Analysis.rectHSNorm r (↑v * F.conjTranspose - F.conjTranspose * ↑u) ^ 2 ≤
        ThomGame.Analysis.rectHSNorm r (↑u * q - q * ↑u) ^ 2 ∧
      ThomGame.Analysis.rectHSNorm r (↑u * F - F * ↑v) ^ 2 ≤ ThomGame.Analysis.rectHSNorm r (↑u * q - q * ↑u) ^ 2
