  (bad : μ) :
  ∃ V W,
    (∀ (i : μ) (j : Fin h), Commute (E i) ↑(V j)) ∧
      (∀ (i : μ) (j : Fin h), Commute (E i) ↑(W j)) ∧
        (∀ (j : Fin h), E bad * ↑(V j) = E bad) ∧
          (∀ (j : Fin h), E bad * ↑(W j) = E bad) ∧
            (∀ (i : μ), i ≠ bad → ∀ (j : Fin h), E i * ↑(V j) + E i * ↑(W j) = 2 • (E i * ↑(U j) * E i)) ∧
              ∑ j, (ThomGame.Analysis.hsNorm (↑(V j) - ↑(U j)) ^ 2 + ThomGame.Analysis.hsNorm (↑(W j) - ↑(U j)) ^ 2) ≤
                8 * ↑h * ∑ i, ThomGame.Analysis.matrixCoordinateEnergy U (E i) +
                  8 * ↑h * ThomGame.Analysis.matrixTraceReal d (E bad)
ThomGame.Analysis.matrixCompressedCoordinateEnergy_le_doubled {d h : ℕ} [NeZero h]
