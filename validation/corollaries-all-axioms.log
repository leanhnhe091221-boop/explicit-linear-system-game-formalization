ThomGame.Analysis.matrixAffineResolvent_hasDerivAt {d : ℕ} {lam t : ℝ} {S F : ThomGame.Analysis.CMatrix d}
  (hlam : 0 < lam) (hS : 0 ≤ S) (hF : 0 ≤ F) (ht : 0 ≤ t) :
  HasDerivAt (ThomGame.Analysis.matrixAffineResolvent lam S F)
    (-ThomGame.Analysis.matrixAffineResolvent lam S F t * F * ThomGame.Analysis.matrixAffineResolvent lam S F t) t
ThomGame.Analysis.matrixResolventPotential_eq_hsNorm_sq {d : ℕ} [NeZero d] {lam : ℝ} {S U : ThomGame.Analysis.CMatrix d}
  (hlam : 0 < lam) (hS : 0 ≤ S) (hU : IsSelfAdjoint U) (hUU : U * U = 1) :
  ThomGame.Analysis.matrixResolventPotential (lam • 1 + S) U =
    1 / 2 *
      ThomGame.Analysis.hsNorm
          (CFC.sqrt (ThomGame.Analysis.matrixPositiveResolvent lam S) * (U * (lam • 1 + S) - (lam • 1 + S) * U) *
            CFC.sqrt (ThomGame.Analysis.matrixPositiveResolvent lam S)) ^
        2
ThomGame.Analysis.matrixResolventPotential_hasDerivAt_dissipation {d : ℕ} {lam t : ℝ}
  {S F U : ThomGame.Analysis.CMatrix d} (hlam : 0 < lam) (hS : 0 ≤ S) (hF : IsStarProjection F) (ht : 0 ≤ t)
  (hU : IsSelfAdjoint U) (hUU : U * U = 1) :
  HasDerivAt (fun s => ThomGame.Analysis.matrixResolventPotential (lam • 1 + S + s • F) U)
    (-(ThomGame.Analysis.normalizedTrace
            (star (U * F - F * U) *
              (U * ThomGame.Analysis.matrixAffineResolvent lam S F t -
                ThomGame.Analysis.matrixAffineResolvent lam S F t * U))).re -
      ThomGame.Analysis.hsNorm
          (CFC.sqrt (U * (lam • 1 + S + t • F) * U) *
              (ThomGame.Analysis.matrixAffineResolvent lam S F t -
                U * ThomGame.Analysis.matrixAffineResolvent lam S F t * U) *
            F) ^
        2)
    t
ThomGame.Analysis.abs_normalizedTrace_commutator_pairing_le {d : ℕ} [NeZero d] {U F D : ThomGame.Analysis.CMatrix d}
  (hU : IsSelfAdjoint U) (hF : IsStarProjection F) (hD : IsSelfAdjoint D) :
  |(ThomGame.Analysis.normalizedTrace (star (U * F - F * U) * (U * D - D * U))).re| ≤
    2 * ThomGame.Analysis.hsNorm (U * F - F * U) * ThomGame.Analysis.hsNorm ((U * D - D * U) * F)
ThomGame.Analysis.matrixResolventPotential_derivative_bound {d : ℕ} [NeZero d] {lam t : ℝ}
  {S F U : ThomGame.Analysis.CMatrix d} (hlam : 0 < lam) (hS : 0 ≤ S) (hF : IsStarProjection F) (ht : 0 ≤ t)
  (hU : IsSelfAdjoint U) (hUU : U * U = 1) :
  deriv (fun s => ThomGame.Analysis.matrixResolventPotential (lam • 1 + S + s • F) U) t ≤
    2 / lam * ThomGame.Analysis.hsNorm (U * F - F * U) ^ 2 -
      lam / 2 *
        ThomGame.Analysis.hsNorm
            ((U * ThomGame.Analysis.matrixAffineResolvent lam S F t -
                ThomGame.Analysis.matrixAffineResolvent lam S F t * U) *
              F) ^
          2
ThomGame.Analysis.matrixResolvent_integrated_family {d : ℕ} [NeZero d] {lam : ℝ} (hlam : 0 < lam)
  (F : ℕ → ThomGame.Analysis.CMatrix d) (hF : ∀ (i : ℕ), IsStarProjection (F i)) (U : ThomGame.Analysis.CMatrix d)
  (hU : IsSelfAdjoint U) (hUU : U * U = 1) (n : ℕ) :
  ∑ i ∈ Finset.range n,
      ∫ (t : ℝ) in 0..1,
        ThomGame.Analysis.matrixResolventColumnEnergy lam (ThomGame.Analysis.matrixProjectionPartialSum 0 F i) (F i) U
          t ≤
    4 / lam ^ 2 * ∑ i ∈ Finset.range n, ThomGame.Analysis.hsNorm (U * F i - F i * U) ^ 2
ThomGame.Analysis.matrixResolvent_column_endpoint_bound {d : ℕ} {lam t : ℝ} {S F : ThomGame.Analysis.CMatrix d}
  (hlam : 0 < lam) (hS : 0 ≤ S) (hF : IsStarProjection F) (ht : 0 ≤ t) (htlam : t ≤ lam / 2)
  (U : ThomGame.Analysis.CMatrix d) :
  ThomGame.Analysis.hsNorm
      ((U * ThomGame.Analysis.matrixPositiveResolvent lam S - ThomGame.Analysis.matrixPositiveResolvent lam S * U) *
        F) ≤
    3 *
        ThomGame.Analysis.hsNorm
          ((U * ThomGame.Analysis.matrixAffineResolvent lam S F t -
              ThomGame.Analysis.matrixAffineResolvent lam S F t * U) *
            F) +
      lam⁻¹ * ThomGame.Analysis.hsNorm (U * F - F * U)
ThomGame.Analysis.matrixResolvent_selfAdjoint_family_bound {d : ℕ} [NeZero d] {lam : ℝ} (hlam : 0 < lam)
  (hlam1 : lam ≤ 1) (F : ℕ → ThomGame.Analysis.CMatrix d) (hF : ∀ (i : ℕ), IsStarProjection (F i))
  (U : ThomGame.Analysis.CMatrix d) (hU : IsSelfAdjoint U) (hUU : U * U = 1) (n : ℕ) :
  ∑ i ∈ Finset.range n,
      ThomGame.Analysis.hsNorm
          ((U * ThomGame.Analysis.matrixPositiveResolvent lam (ThomGame.Analysis.matrixProjectionPartialSum 0 F i) -
              ThomGame.Analysis.matrixPositiveResolvent lam (ThomGame.Analysis.matrixProjectionPartialSum 0 F i) * U) *
            F i) ^
        2 ≤
    146 / lam ^ 3 * ∑ i ∈ Finset.range n, ThomGame.Analysis.hsNorm (U * F i - F i * U) ^ 2
