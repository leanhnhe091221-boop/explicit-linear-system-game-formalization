  ∃ T Q,
    (∀ (k : ℕ) (i : Fin (Q k).n), (Q k).E i ≠ 0) ∧
      (∀ (k : ℕ), (Q k).n ≤ dims k) ∧
        Filter.Tendsto (fun k => ∑ j, ThomGame.Analysis.hsNorm (↑(T k j) - ↑(Fin.append (U k) (U k) j)) ^ 2) (↑L)
            (nhds 0) ∧
          (∀ (j : Fin (h + h)),
              (ThomGame.Analysis.matrixQuotientMk dims ↑L)
                  (ThomGame.Analysis.boundedUnitarySequence dims fun k => T k j) =
                (ThomGame.Analysis.matrixQuotientMk dims ↑L)
                  (ThomGame.Analysis.boundedUnitarySequence dims fun k => Fin.append (U k) (U k) j)) ∧
            ∀ (j : Fin (h + h)),
              ((ThomGame.Analysis.unitarySequenceMk dims ↑L) fun k => T k j) =
                (ThomGame.Analysis.unitarySequenceMk dims ↑L) fun k => Fin.append (U k) (U k) j
