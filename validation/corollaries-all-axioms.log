ThomGame.Analysis.finiteSignSum_expect_norm_sq.{u_1, u_4} {ι : Type u_1} [Fintype ι] [DecidableEq ι] {H : Type u_4}
  [NormedAddCommGroup H] [InnerProductSpace ℝ H] (v : ι → H) :
  (Finset.univ.expect fun ε => ‖ThomGame.Analysis.finiteSignSum v ε‖ ^ 2) = ∑ i, ‖v i‖ ^ 2
ThomGame.Analysis.matrixSignSum_matrixOpNorm_le_one.{u_1} {d : ℕ} {ι : Type u_1} [Fintype ι]
  (P : ι → ThomGame.Analysis.CMatrix d) (hP : ∀ (i : ι), IsStarProjection (P i))
  (horth : Pairwise fun i j => P i * P j = 0) (ε : ι → Bool) :
  ThomGame.Analysis.matrixOpNorm (ThomGame.Analysis.finiteSignSum P ε) ≤ 1
ThomGame.Analysis.matrixMarkovOrthogonalFamily_distance_bound.{u_1} {d h : ℕ} [NeZero d] {ι : Type u_1} [Fintype ι]
  [DecidableEq ι] (U : Fin h → ↥(ThomGame.Analysis.UnitaryMatrix d)) (κ : ℝ) (k : ℕ)
  (P : ι → ThomGame.Analysis.CMatrix d) (hP : ∀ (i : ι), IsStarProjection (P i))
  (horth : Pairwise fun i j => P i * P j = 0) :
  √(∑ i, ThomGame.Analysis.hsNorm (P i - (ThomGame.Analysis.matrixLazyMarkov U ^ k) (P i)) ^ 2) ≤
    (√κ)⁻¹ * √(∑ i, ThomGame.Analysis.matrixCoordinateEnergy U (P i)) + ThomGame.Analysis.matrixMarkovDefectBound U κ k
ThomGame.Analysis.matrixDistanceBad_family_trace_bound.{u_1} {d h : ℕ} [NeZero d] {ι : Type u_1} [Fintype ι]
  [DecidableEq ι] (U : Fin h → ↥(ThomGame.Analysis.UnitaryMatrix d)) (κ α : ℝ) (hκ : 0 < κ) (hα : 0 < α) (k : ℕ)
  (P : ι → ThomGame.Analysis.CMatrix d) (hbad : ∀ (i : ι), ThomGame.Analysis.MatrixDistanceBad U κ α k (P i))
  (horth : Pairwise fun i j => P i * P j = 0) :
  ∑ i, (ThomGame.Analysis.normalizedTrace (P i)).re ≤ κ * ThomGame.Analysis.matrixMarkovDefectBound U κ k ^ 2 / α
ThomGame.Analysis.matrixEnergyBad_family_trace_bound.{u_1} {d h : ℕ} [NeZero d] {ι : Type u_1} [Fintype ι]
  [DecidableEq ι] (U : Fin h → ↥(ThomGame.Analysis.UnitaryMatrix d)) (κ α : ℝ) (hα : 0 < α) (k : ℕ)
  (P : ι → ThomGame.Analysis.CMatrix d) (hbad : ∀ (i : ι), ThomGame.Analysis.MatrixEnergyBad U α k (P i))
  (horth : Pairwise fun i j => P i * P j = 0) :
  ∑ i, (ThomGame.Analysis.normalizedTrace (P i)).re ≤ 36 * ThomGame.Analysis.matrixMarkovDefectBound U κ k ^ 2 / α ^ 2
ThomGame.Analysis.exists_matrixMaximalOrthogonalFamily {d : ℕ} [NeZero d] (B : ThomGame.Analysis.CMatrix d → Prop)
  (hB : ∀ (P : ThomGame.Analysis.CMatrix d), B P → IsStarProjection P ∧ P ≠ 0) :
  ∃ s,
    (∀ P ∈ s, B P) ∧
      ((↑s).Pairwise fun P Q => P * Q = 0) ∧ ∀ (Q : ThomGame.Analysis.CMatrix d), B Q → ¬∀ P ∈ s, P * Q = 0
ThomGame.Analysis.exists_matrixMarkov_good_projection {d h : ℕ} [NeZero d]
  (U : Fin h → ↥(ThomGame.Analysis.UnitaryMatrix d)) (κ α : ℝ) (hκ : 0 < κ) (hκ₁ : κ ≤ 1) (hα : 0 < α) (k : ℕ)
  (hβα : ThomGame.Analysis.matrixMarkovDefectBound U κ k ≤ α ^ 2 / 64) :
  ∃ R,
    IsStarProjection R ∧
      (ThomGame.Analysis.normalizedTrace (1 - R)).re ≤ α ∧
        ∀ (P : ThomGame.Analysis.CMatrix d),
          IsStarProjection P →
            P ≤ R → ¬ThomGame.Analysis.MatrixDistanceBad U κ α k P ∧ ¬ThomGame.Analysis.MatrixEnergyBad U α k P
ThomGame.Analysis.MatrixProjectionImprovement {d h : ℕ} (U : Fin h → ↥(ThomGame.Analysis.UnitaryMatrix d)) (κ α : ℝ)
  (P F : ThomGame.Analysis.CMatrix d) : Prop
ThomGame.Analysis.exists_matrixMarkov_projection_improvement {d h : ℕ} [NeZero d] [NeZero h]
  (U : Fin h → ↥(ThomGame.Analysis.UnitaryMatrix d)) (κ α : ℝ) (hκ : 0 < κ) (hκ₁ : κ ≤ 1) (hα : 0 < α) (k : ℕ)
  (hβα : ThomGame.Analysis.matrixMarkovDefectBound U κ k ≤ α ^ 2 / 64) :
  ∃ R,
    IsStarProjection R ∧
      (ThomGame.Analysis.normalizedTrace (1 - R)).re ≤ α ∧
        ∀ (P : ThomGame.Analysis.CMatrix d),
          IsStarProjection P →
            P ≤ R →
              ThomGame.Analysis.matrixCoordinateEnergy U P ≤ κ * (ThomGame.Analysis.normalizedTrace P).re / 64 →
                ∃ F, ThomGame.Analysis.MatrixProjectionImprovement U κ α P F
ThomGame.Analysis.exists_matrixUltraproduct_projection_improvement (dims : ℕ → ℕ) {h : ℕ} [NeZero h]
  (U : (n : ℕ) → Fin h → ↥(ThomGame.Analysis.UnitaryMatrix (dims n))) (hd : ∀ (n : ℕ), 0 < dims n) (L : Ultrafilter ℕ)
  (hL : ↑L ≤ Filter.atTop) (κ : ℝ) (hgap : ThomGame.Analysis.MatrixMarkovSpectralGap dims U hd L κ) :
  ∃ R α,
    (∀ (n : ℕ), 0 < α n) ∧
      Filter.Tendsto α (↑L) (nhds 0) ∧
        ∀ (n : ℕ),
          IsStarProjection (R n) ∧
            (ThomGame.Analysis.normalizedTrace (1 - R n)).re ≤ α n ∧
              ∀ (P : ThomGame.Analysis.CMatrix (dims n)),
                IsStarProjection P →
                  P ≤ R n →
                    ThomGame.Analysis.matrixCoordinateEnergy (U n) P ≤
                        κ * (ThomGame.Analysis.normalizedTrace P).re / 64 →
                      ∃ F, ThomGame.Analysis.MatrixProjectionImprovement (U n) κ (α n) P F
