ThomGame.Analysis.exists_matrixContraction_unitary_pair.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι] (r : ℕ)
  {X : Matrix ι ι ℂ} (hX : X.conjTranspose * X ≤ 1) :
  ∃ V W,
    ↑V + ↑W = 2 • X ∧
      ThomGame.Analysis.rectHSNorm r (↑V - X) ^ 2 = ThomGame.Analysis.matrixTraceReal r (1 - X.conjTranspose * X) ∧
        ThomGame.Analysis.rectHSNorm r (↑W - X) ^ 2 = ThomGame.Analysis.matrixTraceReal r (1 - X.conjTranspose * X)
ThomGame.Analysis.exists_matrixCorner_unitary_pair.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι] (r : ℕ)
  {q : Matrix ι ι ℂ} (hq : IsStarProjection q) (U : ↥(Matrix.unitaryGroup ι ℂ)) :
  ∃ V W,
    V.conjTranspose * V = q ∧
      V * V.conjTranspose = q ∧
        W.conjTranspose * W = q ∧
          W * W.conjTranspose = q ∧
            V + W = 2 • (q * ↑U * q) ∧
              ThomGame.Analysis.rectHSNorm r (V - q * ↑U * q) ^ 2 =
                  ThomGame.Analysis.matrixTraceReal r (q - (q * ↑U * q).conjTranspose * (q * ↑U * q)) ∧
                ThomGame.Analysis.rectHSNorm r (W - q * ↑U * q) ^ 2 =
                  ThomGame.Analysis.matrixTraceReal r (q - (q * ↑U * q).conjTranspose * (q * ↑U * q))
ThomGame.Analysis.rectHSNorm_corner_correction_pythagoras.{u_1, u_2} {ι : Type u_1} {μ : Type u_2} [Fintype ι]
  [Fintype μ] (r : ℕ) (E Y : μ → Matrix ι ι ℂ) (hE : ∀ (i : μ), IsStarProjection (E i))
  (horth : Pairwise fun i j => E i * E j = 0) (hleft : ∀ (i : μ), E i * Y i = Y i) (hright : ∀ (i : μ), Y i * E i = Y i)
  (X : Matrix ι ι ℂ) :
  ThomGame.Analysis.rectHSNorm r (∑ i, Y i - X) ^ 2 =
    ThomGame.Analysis.rectHSNorm r (X - ThomGame.Analysis.matrixBlockPinch E X) ^ 2 +
      ∑ i, ThomGame.Analysis.rectHSNorm r (Y i - E i * X * E i) ^ 2
ThomGame.Analysis.exists_matrixPartition_unitary_tuple.{u_1} {μ : Type u_1} [Fintype μ] {d h : ℕ} [NeZero h]
