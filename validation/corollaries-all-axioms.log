            (γ : A.hypergraph.Cycle) → ThomGame.Pictures.PortGraph.RimDart G γ → Bool :=
fun {R} {S} [DecidableEq R] [DecidableEq S] {A} G γ x =>
  if ThomGame.Pictures.PortGraph.RimCorner G γ false x then false else true
