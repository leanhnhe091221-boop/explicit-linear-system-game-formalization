ThomGame.Analysis.matrixScalarGapPartition_internal_masa.{u_1} {ι : Type u_1} (dims : ι → ℕ) {h : ℕ}
  (U : (k : ι) → Fin h → ↥(ThomGame.Analysis.UnitaryMatrix (dims k))) (hd : ∀ (k : ι), 0 < dims k) (c : ℝ)
  (Q : (k : ι) → ThomGame.Analysis.MatrixScalarGapPartition (U k) c) (L : Filter ι) (hc : 0 < c)
  (hne : ∀ (k : ι) (i : Fin (Q k).n), (Q k).E i ≠ 0) :
  StarSubalgebra.centralizer ℂ
        ↑(ThomGame.Analysis.matrixInternalQuotient dims
            (fun k => ThomGame.Analysis.matrixPartitionScalarAlgebra (Q k).E) L) ⊓
      ThomGame.Analysis.matrixRelativeCommutant dims U L =
    ThomGame.Analysis.matrixInternalQuotient dims (fun k => ThomGame.Analysis.matrixPartitionScalarAlgebra (Q k).E) L
ThomGame.Analysis.exists_matrixALT_corrected_power_expectation (dims : ℕ → ℕ) {h : ℕ} [NeZero h]
  (U : (k : ℕ) → Fin h → ↥(ThomGame.Analysis.UnitaryMatrix (dims k))) (hd : ∀ (k : ℕ), 0 < dims k) (L : Ultrafilter ℕ)
  (hL : ↑L ≤ Filter.atTop) (κ : ℝ) (hgap : ThomGame.Analysis.MatrixMarkovSpectralGap dims U hd L κ)
  (T : (k : ℕ) → Fin (h + h) → ↥(ThomGame.Analysis.UnitaryMatrix (dims k)))
  (hTU :
    Filter.Tendsto (fun k => ∑ j, ThomGame.Analysis.hsNorm (↑(T k j) - ↑(Fin.append (U k) (U k) j)) ^ 2) (↑L)
      (nhds 0)) :
  ∃ N,
    (∀ (k : ℕ), 0 < N k) ∧
      Filter.Tendsto N (↑L) Filter.atTop ∧
        (∀ᶠ (k : ℕ) in ↑L, N k ≤ ThomGame.Analysis.matrixMarkovDiagonalPower dims U hd κ k) ∧
          Filter.Tendsto
              (((ThomGame.Analysis.matrixUniformMarkovPower dims T hd N).sub
                    (ThomGame.Analysis.matrixUniformMarkovPower dims U hd N)).coordinateMixedNorm
                hd)
              (↑L) (nhds 0) ∧
            (ThomGame.Analysis.matrixUniformMarkovPower dims T hd N).quotientMap ↑L =
              ThomGame.Analysis.matrixRelativeExpectation dims U hd L hL
ThomGame.Analysis.exists_matrixUltraproduct_ALT_corollary5_1 (dims : ℕ → ℕ) {h : ℕ} [NeZero h]
  (U : (k : ℕ) → Fin h → ↥(ThomGame.Analysis.UnitaryMatrix (dims k))) (hd : ∀ (k : ℕ), 0 < dims k) (L : Ultrafilter ℕ)
  (hL : ↑L ≤ Filter.atTop) (κ : ℝ) (hgap : ThomGame.Analysis.MatrixMarkovSpectralGap dims U hd L κ) :
  ∃ T Q N Ψ,
    (∀ (k : ℕ) (i : Fin (Q k).n), (Q k).E i ≠ 0) ∧
      (∀ (k : ℕ), (Q k).n ≤ dims k) ∧
        Filter.Tendsto (fun k => ∑ j, ThomGame.Analysis.hsNorm (↑(T k j) - ↑(Fin.append (U k) (U k) j)) ^ 2) (↑L)
            (nhds 0) ∧
          (∀ (j : Fin (h + h)),
              ThomGame.Analysis.matrixTupleClass dims T (↑L) j =
                ThomGame.Analysis.matrixTupleClass dims (fun k => Fin.append (U k) (U k)) (↑L) j) ∧
            (∀ (k : ℕ), 0 < N k) ∧
              Filter.Tendsto N (↑L) Filter.atTop ∧
                (∀ (k : ℕ),
                    (Ψ k).toLinearMap = (ThomGame.Analysis.matrixUniformMarkovPower dims T hd N).toLinearMap k) ∧
                  (∀ (k : ℕ), (Ψ k) 1 = 1) ∧
                    (∀ (k : ℕ) (X : ThomGame.Analysis.CMatrix (dims k)),
                        ThomGame.Analysis.normalizedTrace ((Ψ k) X) = ThomGame.Analysis.normalizedTrace X) ∧
                      (∀ (k : ℕ) (A X B : ThomGame.Analysis.CMatrix (dims k)),
                          A ∈ ThomGame.Analysis.matrixPartitionScalarAlgebra (Q k).E →
                            B ∈ ThomGame.Analysis.matrixPartitionScalarAlgebra (Q k).E →
                              (Ψ k) (A * X * B) = A * (Ψ k) X * B) ∧
                        (∀ (k : ℕ) (X Y : ThomGame.Analysis.CMatrix (dims k)),
                            ThomGame.Analysis.normalizedTrace (star ((Ψ k) X) * Y) =
                              ThomGame.Analysis.normalizedTrace (star X * (Ψ k) Y)) ∧
                          (ThomGame.Analysis.matrixUniformMarkovPower dims T hd N).quotientMap ↑L =
                              ThomGame.Analysis.matrixRelativeExpectation dims U hd L hL ∧
                            Filter.Tendsto (ThomGame.Analysis.matrixScalarCornerErrorSequence dims T hd Q N) (↑L)
                                (nhds 0) ∧
                              ThomGame.Analysis.matrixInternalQuotient dims
                                    (fun k => ThomGame.Analysis.matrixPartitionScalarAlgebra (Q k).E) ↑L ≤
                                  ThomGame.Analysis.matrixRelativeCommutant dims U ↑L ∧
                                StarSubalgebra.centralizer ℂ
                                      ↑(ThomGame.Analysis.matrixInternalQuotient dims
                                          (fun k => ThomGame.Analysis.matrixPartitionScalarAlgebra (Q k).E) ↑L) ⊓
                                    ThomGame.Analysis.matrixRelativeCommutant dims U ↑L =
                                  ThomGame.Analysis.matrixInternalQuotient dims
                                    (fun k => ThomGame.Analysis.matrixPartitionScalarAlgebra (Q k).E) ↑L
