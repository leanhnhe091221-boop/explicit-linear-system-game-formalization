ThomGame.Analysis.matrixALT_lowSpectral_polar_transport {d h : ℕ} [NeZero h]
  (U : Fin h → ↥(ThomGame.Analysis.UnitaryMatrix d)) {S R : ThomGame.Analysis.CMatrix d} (hS : 0 ≤ S)
  (hR : IsStarProjection R) (hSR : 1 - R ≤ S) {κ : ℝ} (hκ : κ ≤ 1) :
  have b := ThomGame.Analysis.matrixClosedLowSpectralCut S (κ / 512);
  have w := ThomGame.Analysis.matrixRectPolar (R * b);
  w.conjTranspose * w = b ∧
    w * w.conjTranspose ≤ R ∧
      b * w * b = ThomGame.Analysis.matrixRectAbs (R * b) ∧
        ∀ (p : ThomGame.Analysis.CMatrix d),
          IsStarProjection p →
            p ≤ b →
              IsStarProjection (w * p * w.conjTranspose) ∧
                w * p * w.conjTranspose ≤ R ∧
                  ThomGame.Analysis.matrixTraceReal d (w * p * w.conjTranspose) =
                      ThomGame.Analysis.matrixTraceReal d p ∧
                    (w * p * w.conjTranspose).rank = Matrix.rank p ∧
                      ThomGame.Analysis.hsNorm (w * p * w.conjTranspose - p) ^ 2 ≤
                          κ / 256 * ThomGame.Analysis.matrixTraceReal d p ∧
                        ThomGame.Analysis.matrixCoordinateEnergy U (w * p * w.conjTranspose) ≤
                          2 * ThomGame.Analysis.matrixCoordinateEnergy U p +
                            κ / 128 * ThomGame.Analysis.matrixTraceReal d p
ThomGame.Analysis.matrixALTSelectionPotential_increment_ge_source {d : ℕ} {S F : ThomGame.Analysis.CMatrix d}
  (hS : 0 ≤ S) (hF : IsStarProjection F) {κ : ℝ} (hκ : 0 ≤ κ) :
  4 / (5 * (1 + κ / 128) ^ 2) *
      ThomGame.Analysis.matrixTraceReal d (ThomGame.Analysis.matrixClosedLowSpectralCut S (κ / 512) * F) ≤
    ThomGame.Analysis.matrixALTSelectionPotential (S + F) - ThomGame.Analysis.matrixALTSelectionPotential S
ThomGame.Analysis.exists_matrixALTSelection_family {d h : ℕ} [NeZero d]
  (U : Fin h → ↥(ThomGame.Analysis.UnitaryMatrix d)) {κ α : ℝ} (hκ : 0 < κ) (hκ1 : κ ≤ 1) (hα : 0 ≤ α)
  {R : ThomGame.Analysis.CMatrix d} (hR : IsStarProjection R)
  (hcorrect :
    ∀ (p : ThomGame.Analysis.CMatrix d),
      IsStarProjection p →
        p ≤ R →
          ThomGame.Analysis.matrixCoordinateEnergy U p ≤ κ * (ThomGame.Analysis.normalizedTrace p).re / 64 →
            ∃ F, ThomGame.Analysis.MatrixProjectionImprovement U κ α p F) :
  ∃ n ≤ 8 * d,
    ∃ S P F,
      S 0 = 1 - R ∧
        (∀ (i : ℕ), 1 - R ≤ S i) ∧
          (∀ (i : Fin n),
              ThomGame.Analysis.MatrixALTSelectionCandidate U κ R (S ↑i) (P i) ∧
                (∀ (q : ThomGame.Analysis.CMatrix d),
                    ThomGame.Analysis.MatrixALTSelectionCandidate U κ R (S ↑i) q → Matrix.rank (P i) ≤ Matrix.rank q) ∧
                  ThomGame.Analysis.MatrixProjectionImprovement U κ α (P i) (F i) ∧ S (↑i + 1) = S ↑i + F i) ∧
            (¬∃ p, ThomGame.Analysis.MatrixALTSelectionCandidate U κ R (S n) p) ∧
              S n = 1 - R + ∑ i, F i ∧
                ∑ i, ThomGame.Analysis.matrixTraceReal d (P i) ≤ 8 ∧
                  ∑ i, ThomGame.Analysis.matrixTraceReal d (F i) ≤ 8 / 3 ∧
                    ∑ i, ThomGame.Analysis.matrixCoordinateEnergy U (F i) ≤ 8 * α
ThomGame.Analysis.exists_matrixUltraproduct_ALT_selection (dims : ℕ → ℕ) {h : ℕ} [NeZero h]
  (U : (k : ℕ) → Fin h → ↥(ThomGame.Analysis.UnitaryMatrix (dims k))) (hd : ∀ (k : ℕ), 0 < dims k) (L : Ultrafilter ℕ)
  (hL : ↑L ≤ Filter.atTop) (κ : ℝ) (hgap : ThomGame.Analysis.MatrixMarkovSpectralGap dims U hd L κ) :
  ∃ R α,
    (∀ (k : ℕ), 0 < α k) ∧
      Filter.Tendsto α (↑L) (nhds 0) ∧
        ∀ (k : ℕ),
          IsStarProjection (R k) ∧
            (ThomGame.Analysis.normalizedTrace (1 - R k)).re ≤ α k ∧
              ∃ m ≤ 8 * dims k,
                ∃ S P F,
                  S 0 = 1 - R k ∧
                    (∀ (i : ℕ), 1 - R k ≤ S i) ∧
                      (∀ (i : Fin m),
                          ThomGame.Analysis.MatrixALTSelectionCandidate (U k) κ (R k) (S ↑i) (P i) ∧
                            (∀ (q : ThomGame.Analysis.CMatrix (dims k)),
                                ThomGame.Analysis.MatrixALTSelectionCandidate (U k) κ (R k) (S ↑i) q →
                                  Matrix.rank (P i) ≤ Matrix.rank q) ∧
                              ThomGame.Analysis.MatrixProjectionImprovement (U k) κ (α k) (P i) (F i) ∧
                                S (↑i + 1) = S ↑i + F i) ∧
                        (¬∃ p, ThomGame.Analysis.MatrixALTSelectionCandidate (U k) κ (R k) (S m) p) ∧
                          S m = 1 - R k + ∑ i, F i ∧
                            ∑ i, ThomGame.Analysis.matrixTraceReal (dims k) (P i) ≤ 8 ∧
                              ∑ i, ThomGame.Analysis.matrixTraceReal (dims k) (F i) ≤ 8 / 3 ∧
                                ∑ i, ThomGame.Analysis.matrixCoordinateEnergy (U k) (F i) ≤ 8 * α k
