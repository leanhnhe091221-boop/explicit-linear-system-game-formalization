ThomGame.Analysis.matrixFamilyCoverageDefect_eq_zero_iff.{u_1} {d : ℕ} [NeZero d] {ι : Type u_1} [Fintype ι]
  (P : ι → ThomGame.Analysis.CMatrix d) (hP : ∀ (i : ι), IsStarProjection (P i)) :
  ThomGame.Analysis.matrixFamilyCoverageDefect P = 0 ↔ 1 ≤ ∑ i, P i
ThomGame.Analysis.matrixFamilyCoverageDefect_orthogonal.{u_1} {d : ℕ} {ι : Type u_1} [Fintype ι]
  (P : ι → ThomGame.Analysis.CMatrix d) (hP : ∀ (i : ι), IsStarProjection (P i))
  (horth : Pairwise fun i j => P i * P j = 0) :
  ThomGame.Analysis.matrixFamilyCoverageDefect P = (ThomGame.Analysis.normalizedTrace (1 - ∑ i, P i)).re
ThomGame.Analysis.normalizedTrace_posPart_add_le {d : ℕ} {A B : ThomGame.Analysis.CMatrix d} (hA : IsSelfAdjoint A)
  (hB : IsSelfAdjoint B) :
  (ThomGame.Analysis.normalizedTrace (A + B)⁺).re ≤
    (ThomGame.Analysis.normalizedTrace A⁺).re + (ThomGame.Analysis.normalizedTrace B⁺).re
ThomGame.Analysis.matrixFamilyCoverageDefect_comparison.{u_1} {d : ℕ} {ι : Type u_1} [Fintype ι]
  (D Q : ι → ThomGame.Analysis.CMatrix d) (hD : ∀ (i : ι), IsSelfAdjoint (D i)) (hQ : ∀ (i : ι), IsStarProjection (Q i))
  (hD1 : ∑ i, D i ≤ 1) :
  ThomGame.Analysis.matrixFamilyCoverageDefect Q ≤
    (ThomGame.Analysis.normalizedTrace (1 - ∑ i, D i)).re + ∑ i, (ThomGame.Analysis.normalizedTrace (D i - Q i)⁺).re
ThomGame.Analysis.matrixPositiveResolvent_eq_inverse {d : ℕ} {S : ThomGame.Analysis.CMatrix d} {lam : ℝ}
  (hlam : 0 < lam) (hS : 0 ≤ S) : ThomGame.Analysis.matrixPositiveResolvent lam S = (lam • 1 + S)⁻¹
ThomGame.Analysis.matrixProjectionResolventDifference_eq_factor {d : ℕ} {S F : ThomGame.Analysis.CMatrix d} {lam : ℝ}
  (hlam : 0 < lam) (hS : 0 ≤ S) (hF : IsStarProjection F) :
  ThomGame.Analysis.matrixProjectionResolventDifference lam S F =
    ThomGame.Analysis.matrixProjectionResolventFactor lam S F *
      star (ThomGame.Analysis.matrixProjectionResolventFactor lam S F)
ThomGame.Analysis.matrixProjectionResolventDifference_rank_le {d : ℕ} {S F : ThomGame.Analysis.CMatrix d} {lam : ℝ}
  (hlam : 0 < lam) (hS : 0 ≤ S) (hF : IsStarProjection F) :
  Matrix.rank (ThomGame.Analysis.matrixProjectionResolventDifference lam S F) ≤ Matrix.rank F
ThomGame.Analysis.matrixProjectionResolventDifference_weighted_trace_le {d : ℕ} {S F : ThomGame.Analysis.CMatrix d}
  {lam : ℝ} (hlam : 0 < lam) (hS : 0 ≤ S) (hF : IsStarProjection F) :
  (ThomGame.Analysis.normalizedTrace (S ^ 2 * ThomGame.Analysis.matrixProjectionResolventDifference lam S F)).re ≤
    lam * (ThomGame.Analysis.normalizedTrace F).re
ThomGame.Analysis.matrixResolventDifferenceFamily_sum {d : ℕ} (lam : ℝ) (S₀ : ThomGame.Analysis.CMatrix d)
  (F : ℕ → ThomGame.Analysis.CMatrix d) (n : ℕ) :
  ∑ i ∈ Finset.range n, ThomGame.Analysis.matrixResolventDifferenceFamily lam S₀ F i =
    lam •
      (ThomGame.Analysis.matrixPositiveResolvent lam S₀ -
        ThomGame.Analysis.matrixPositiveResolvent lam (ThomGame.Analysis.matrixProjectionPartialSum S₀ F n))
ThomGame.Analysis.matrixResolventDifferenceFamily_weighted_trace_sum_le {d : ℕ} {lam : ℝ} (hlam : 0 < lam)
  {S₀ : ThomGame.Analysis.CMatrix d} (hS₀ : 0 ≤ S₀) (F : ℕ → ThomGame.Analysis.CMatrix d)
  (hF : ∀ (i : ℕ), IsStarProjection (F i)) (n : ℕ) :
  ∑ i ∈ Finset.range n,
      (ThomGame.Analysis.normalizedTrace
          (ThomGame.Analysis.matrixProjectionPartialSum S₀ F i ^ 2 *
            ThomGame.Analysis.matrixResolventDifferenceFamily lam S₀ F i)).re ≤
    lam * ∑ i ∈ Finset.range n, (ThomGame.Analysis.normalizedTrace (F i)).re
ThomGame.Analysis.matrixResolventFamily_coverage_of_rounding {d : ℕ} {γ : ℝ} [NeZero d] (hγ : 0 < γ)
  {P : ThomGame.Analysis.CMatrix d} (hP : IsStarProjection P) (F : ℕ → ThomGame.Analysis.CMatrix d)
  (hF : ∀ (i : ℕ), IsStarProjection (F i)) (n : ℕ) (Q : Fin n → ThomGame.Analysis.CMatrix d)
  (hQ : ∀ (i : Fin n), IsStarProjection (Q i))
  (herr :
    ∑ i,
        (ThomGame.Analysis.normalizedTrace
            (ThomGame.Analysis.matrixResolventDifferenceFamily (γ ^ 2) P F ↑i - Q i)⁺).re ≤
      6 * γ) :
  ThomGame.Analysis.matrixFamilyCoverageDefect Q ≤
    (ThomGame.Analysis.normalizedTrace P).re +
        (ThomGame.Analysis.normalizedTrace
            (1 - ThomGame.Analysis.matrixSpectralCut (ThomGame.Analysis.matrixProjectionPartialSum P F n) γ)).re +
      7 * γ
