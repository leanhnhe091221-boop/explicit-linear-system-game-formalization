            (γ : A.hypergraph.Cycle) → Bool → ThomGame.Pictures.PortGraph.RimDart G γ → Prop :=
fun {R} {S} [DecidableEq R] [DecidableEq S] {A} G γ side x =>
  match side with
  | false => (ThomGame.Pictures.PortGraph.rotation G) ↑(ThomGame.Pictures.PortGraph.rimSwitch G γ ⋯ ⋯ x) = ↑x
