ThomGame.Pictures.PortGraph.ClosedMinimalOddState.hubs_reachable.{u_1, u_2} {R : Type u_1} {S : Type u_2}
  {P : ThomGame.InvolutionPresentation R S} {G : ThomGame.Pictures.PortGraph P [] []} (h : G.ClosedMinimalOddState)
  (hn : ∀ (x : G.Hub), 0 < (P.word (G.hubLabel x)).length) (x y : G.Hub) :
  G.Reachable (Sum.inr (Sum.inl x)) (Sum.inr (Sum.inl y))
ThomGame.Pictures.PortGraph.ClosedMinimalOddState.exists_minimal_circuit_diagrams.{u_1, u_2} {R : Type u_1}
  {S : Type u_2} {P : ThomGame.InvolutionPresentation R S} {G : ThomGame.Pictures.PortGraph P [] []}
  (h : G.ClosedMinimalOddState) (hn : ∀ (x : G.Hub), 0 < (P.word (G.hubLabel x)).length) (C : G.SimpleCircuit)
  (s : Bool) :
  ∃ g e,
    ↑g.labels = ∑ x, ↑[G.hubLabel ↑x] ∧
      ↑e.labels = ∑ x, ↑[G.hubLabel ↑x] ∧
        g.size = Fintype.card (C.GermHub s) ∧
          e.size = Fintype.card (C.InteriorHub !s) ∧
            g.sign = (C.germGraph ⋯ s).sign ∧ e.sign = (C.regionGraph ⋯ !s).sign ∧ g.Minimal ∧ e.Minimal
