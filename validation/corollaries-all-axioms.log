  [InnerProductSpace ℂ H] {h : ℕ} [NeZero h] (V : Fin h → H ≃ₗᵢ[ℂ] H) [CompleteSpace H] (ξ : H) :
  ‖ξ - (ThomGame.Analysis.lazyHilbertAverage V) ξ‖ ^ 2 ≤ (inner ℂ ξ (ξ - (ThomGame.Analysis.lazyHilbertAverage V) ξ)).re
