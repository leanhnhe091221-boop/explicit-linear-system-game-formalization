ThomGame.Construction.smoothedSigmaRim_exists_decreasing_replacement {d : ThomGame.Construction.SigmaDiagram [] []}
  {H : ThomGame.Construction.SigmaGraph [] []} (t : ThomGame.Construction.SigmaGraphWitness d H) [IsEmpty H.Joint]
  (hmin : ThomGame.Pictures.Diagram.Minimal d) (hs : ThomGame.Pictures.Diagram.sign d = 1)
  (i : ThomGame.Construction.WheelCycleIndex)
  (a : ThomGame.Pictures.PortGraph.RimDart H (ThomGame.Construction.numberedWheelCycles i))
  (hi : i ≠ ThomGame.Construction.oddWheelCycle)
  (hn : ¬∃ side, (ThomGame.Construction.closedSigmaRimCircuit H i a).BoundsFaceOrbit side) :
  ∃ H',
    IsEmpty H'.Joint ∧
      Fintype.card H'.Hub = ThomGame.Pictures.Diagram.size d ∧
        ThomGame.Pictures.PortGraph.sign H' = 1 ∧
          ThomGame.Pictures.RibbonConnectivity.eulerDefect H'.pairing.perm
                (ThomGame.Pictures.PortGraph.circuitStep H') =
              0 ∧
            ThomGame.Construction.sigmaNonfacialRimCount H' i < ThomGame.Construction.sigmaNonfacialRimCount H i ∧
              (∀ (j : ThomGame.Construction.WheelCycleIndex),
                  i ≠ j → ThomGame.Construction.SigmaRimsFacial H j → ThomGame.Construction.SigmaRimsFacial H' j) ∧
                ∃ f,
                  ↑(ThomGame.Pictures.Diagram.labels f) = ∑ h, ↑[H'.hubLabel h] ∧
                    ThomGame.Pictures.Diagram.size f = ThomGame.Pictures.Diagram.size d ∧
                      ThomGame.Pictures.Diagram.sign f = 1 ∧ ThomGame.Pictures.Diagram.Minimal f
