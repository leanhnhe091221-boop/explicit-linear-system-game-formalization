structure ThomGame.Pictures.PortGraph.SimpleCircuit.{u_1, u_2} {R : Type u_1} {S : Type u_2}
  {P : ThomGame.InvolutionPresentation R S} {u v : List S} (G : ThomGame.Pictures.PortGraph P u v) : Type
number of parameters: 6
fields:
  ThomGame.Pictures.PortGraph.SimpleCircuit.length : ℕ
  ThomGame.Pictures.PortGraph.SimpleCircuit.length_pos : 0 < self.length
  ThomGame.Pictures.PortGraph.SimpleCircuit.dart : Fin self.length ↪ G.Dart
  ThomGame.Pictures.PortGraph.SimpleCircuit.vertex_injective : Function.Injective fun i =>
      ThomGame.Pictures.Port.vertex (self.dart i)
  ThomGame.Pictures.PortGraph.SimpleCircuit.edge_injective : Function.Injective fun i => G.pairing.edge (self.dart i)
  ThomGame.Pictures.PortGraph.SimpleCircuit.next_vertex : ∀ (i : Fin self.length),
      ThomGame.Pictures.Port.vertex (self.dart ((finRotate self.length) i)) = (G.pairing.twin (self.dart i)).vertex
  ThomGame.Pictures.PortGraph.SimpleCircuit.next_ne_twin : ∀ (i : Fin self.length),
      self.dart ((finRotate self.length) i) ≠ G.pairing.twin (self.dart i)
constructor:
  ThomGame.Pictures.PortGraph.SimpleCircuit.mk.{u_1, u_2} {R : Type u_1} {S : Type u_2}
    {P : ThomGame.InvolutionPresentation R S} {u v : List S} {G : ThomGame.Pictures.PortGraph P u v} (length : ℕ)
    (length_pos : 0 < length) (dart : Fin length ↪ G.Dart)
    (vertex_injective : Function.Injective fun i => ThomGame.Pictures.Port.vertex (dart i))
    (edge_injective : Function.Injective fun i => G.pairing.edge (dart i))
    (next_vertex :
      ∀ (i : Fin length),
        ThomGame.Pictures.Port.vertex (dart ((finRotate length) i)) = (G.pairing.twin (dart i)).vertex)
    (next_ne_twin : ∀ (i : Fin length), dart ((finRotate length) i) ≠ G.pairing.twin (dart i)) : G.SimpleCircuit
