ThomGame.Pictures.PortGraph.partialDartSwap_step.{u_1, u_2} {R : Type u_1} {S : Type u_2}
  {P : ThomGame.InvolutionPresentation R S} {u v w : List S} (G : ThomGame.Pictures.PortGraph P u v)
  (H : ThomGame.Pictures.PortGraph P v w) (i : Fin v.length) :
  G.partialDartSwap H (↑i + 1) =
    Equiv.swap (Sum.inl (ThomGame.Pictures.Port.bottom i)) (Sum.inr (ThomGame.Pictures.Port.top i)) *
      G.partialDartSwap H ↑i
