ThomGame.Analysis.rectHSNorm_cfc_intertwiner_le_of_spectral_bound.{u_1, u_2} {ι : Type u_1} {κ : Type u_2} [Fintype ι]
  [Fintype κ] [DecidableEq ι] [DecidableEq κ] (r : ℕ) {A : Matrix ι ι ℂ} {B : Matrix κ κ ℂ} (hA : A.IsHermitian)
  (hB : B.IsHermitian) (f g : ℝ → ℝ) {L : ℝ} (hL : 0 ≤ L)
  (hfg : ∀ (i : ι) (j : κ), |f (hA.eigenvalues i) - g (hB.eigenvalues j)| ≤ L * |hA.eigenvalues i - hB.eigenvalues j|)
  (X : Matrix ι κ ℂ) :
  ThomGame.Analysis.rectHSNorm r (cfc f A * X - X * cfc g B) ≤ L * ThomGame.Analysis.rectHSNorm r (A * X - X * B)
ThomGame.Analysis.hsNorm_cfc_sub_le {d : ℕ} {A B : ThomGame.Analysis.CMatrix d} (hA : Matrix.IsHermitian A)
  (hB : Matrix.IsHermitian B) (f : ℝ → ℝ) {L : ℝ} (hL : 0 ≤ L) (hf : ∀ (a b : ℝ), |f a - f b| ≤ L * |a - b|) :
  ThomGame.Analysis.hsNorm (cfc f A - cfc f B) ≤ L * ThomGame.Analysis.hsNorm (A - B)
ThomGame.Analysis.matrixSelfAdjointDilation_abs.{u_1, u_2} {ι : Type u_1} {κ : Type u_2} [Fintype ι] [Fintype κ]
  [DecidableEq ι] [DecidableEq κ] (X : Matrix ι κ ℂ) :
  CFC.abs (ThomGame.Analysis.matrixSelfAdjointDilation X) =
    Matrix.fromBlocks (ThomGame.Analysis.matrixRectAbs X.conjTranspose) 0 0 (ThomGame.Analysis.matrixRectAbs X)
ThomGame.Analysis.rectHSNorm_rectAbs_pair_sub_sq_le.{u_1, u_2} {ι : Type u_1} {κ : Type u_2} [Fintype ι] [Fintype κ]
  [DecidableEq ι] [DecidableEq κ] (r : ℕ) (X Y : Matrix ι κ ℂ) :
  ThomGame.Analysis.rectHSNorm r
          (ThomGame.Analysis.matrixRectAbs X.conjTranspose - ThomGame.Analysis.matrixRectAbs Y.conjTranspose) ^
        2 +
      ThomGame.Analysis.rectHSNorm r (ThomGame.Analysis.matrixRectAbs X - ThomGame.Analysis.matrixRectAbs Y) ^ 2 ≤
    2 * ThomGame.Analysis.rectHSNorm r (X - Y) ^ 2
ThomGame.Analysis.rectHSNorm_rectAbs_sub_sq_le.{u_1, u_2} {ι : Type u_1} {κ : Type u_2} [Fintype ι] [Fintype κ]
  [DecidableEq ι] [DecidableEq κ] (r : ℕ) (X Y : Matrix ι κ ℂ) :
  ThomGame.Analysis.rectHSNorm r (ThomGame.Analysis.matrixRectAbs X - ThomGame.Analysis.matrixRectAbs Y) ^ 2 ≤
    2 * ThomGame.Analysis.rectHSNorm r (X - Y) ^ 2
ThomGame.Analysis.hsNorm_cfcAbs_sub_sq_le {d : ℕ} (X Y : ThomGame.Analysis.CMatrix d) :
  ThomGame.Analysis.hsNorm (CFC.abs X - CFC.abs Y) ^ 2 ≤ 2 * ThomGame.Analysis.hsNorm (X - Y) ^ 2
ThomGame.Analysis.matrixCoordinateEnergy_cfc_le {d h : ℕ} {A : ThomGame.Analysis.CMatrix d}
  (U : Fin h → ↥(ThomGame.Analysis.UnitaryMatrix d)) (hA : Matrix.IsHermitian A) (f : ℝ → ℝ) {L : ℝ} (hL : 0 ≤ L)
  (hf : ∀ (a b : ℝ), |f a - f b| ≤ L * |a - b|) :
  ThomGame.Analysis.matrixCoordinateEnergy U (cfc f A) ≤ L ^ 2 * ThomGame.Analysis.matrixCoordinateEnergy U A
ThomGame.Analysis.hsNorm_normClamp_sub_le {d : ℕ} {A : ThomGame.Analysis.CMatrix d} (K : ℝ)
  {B : ThomGame.Analysis.CMatrix d} (hA : Matrix.IsHermitian A) (hB : Matrix.IsHermitian B) :
  ThomGame.Analysis.hsNorm (ThomGame.Analysis.cstarNormClamp K A - ThomGame.Analysis.cstarNormClamp K B) ≤
    ThomGame.Analysis.hsNorm (A - B)
