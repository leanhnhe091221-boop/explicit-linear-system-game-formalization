    √((∑ k, (ThomGame.Analysis.normalizedTrace (X k)).re) / (2 * a) *
        ∑ k, ThomGame.Analysis.matrixCoordinateEnergy U (X k))
ThomGame.Analysis.exists_matrixFamilySpectralInterval_energy_le.{u_1} {d h : ℕ} {ι : Type u_1} [Fintype ι] [NeZero h]
  (X : ι → ThomGame.Analysis.CMatrix d) (hX₀ : ∀ (k : ι), 0 ≤ X k) (hX₁ : ∀ (k : ι), X k ≤ 1)
  (U : Fin h → ↥(ThomGame.Analysis.UnitaryMatrix d)) (a b : ℝ) (ha : 0 < a) (hab : a < b) :
  ∃ s ∈ Set.Icc a b,
    ∑ k, ThomGame.Analysis.matrixCoordinateEnergy U (ThomGame.Analysis.matrixSpectralInterval (X k) s 1) ≤
      √((∑ k, (ThomGame.Analysis.normalizedTrace (X k)).re) / (2 * a) *
            ∑ k, ThomGame.Analysis.matrixCoordinateEnergy U (X k)) /
        (b - a)
ThomGame.Analysis.matrixSpectralCut_distance_le {d : ℕ} {X P : ThomGame.Analysis.CMatrix d} (hX : Matrix.IsHermitian X)
  (hP : IsStarProjection P) (s : ℝ) (hs : s ∈ Set.Icc (1 / 3) (2 / 3)) :
  ThomGame.Analysis.hsNorm (ThomGame.Analysis.matrixSpectralCut X s - P) ^ 2 ≤ 9 * ThomGame.Analysis.hsNorm (X - P) ^ 2
ThomGame.Analysis.matrixProjection_trace_difference_le {d : ℕ} {P Q : ThomGame.Analysis.CMatrix d}
  (hP : IsStarProjection P) (hQ : IsStarProjection Q) :
  |(ThomGame.Analysis.normalizedTrace P).re - (ThomGame.Analysis.normalizedTrace Q).re| ≤
    ThomGame.Analysis.hsNorm (P - Q) ^ 2
ThomGame.Analysis.exists_matrixProjection_improvement_of_estimates {d h : ℕ} [NeZero h]
  {X P : ThomGame.Analysis.CMatrix d} (hP : IsStarProjection P) (hX : Matrix.PosSemidef X)
  (U : Fin h → ↥(ThomGame.Analysis.UnitaryMatrix d)) (κ α : ℝ) (hκ : 0 < κ) (hα : 0 ≤ α)
  (ht : (ThomGame.Analysis.normalizedTrace X).re = (ThomGame.Analysis.normalizedTrace P).re)
  (hdist : ThomGame.Analysis.hsNorm (X - P) ^ 2 ≤ 4 * κ⁻¹ * ThomGame.Analysis.matrixCoordinateEnergy U P)
  (henergy : ThomGame.Analysis.matrixCoordinateEnergy U X ≤ α ^ 2 * (ThomGame.Analysis.normalizedTrace P).re / 36)
  (hthreshold : ThomGame.Analysis.matrixCoordinateEnergy U P ≤ κ * (ThomGame.Analysis.normalizedTrace P).re / 64) :
  ∃ F,
    IsStarProjection F ∧
      ThomGame.Analysis.hsNorm (F - P) ^ 2 ≤ 36 * κ⁻¹ * ThomGame.Analysis.matrixCoordinateEnergy U P ∧
        1 / 3 * (ThomGame.Analysis.normalizedTrace P).re ≤ (ThomGame.Analysis.normalizedTrace F).re ∧
          (ThomGame.Analysis.normalizedTrace F).re ≤ 5 / 3 * (ThomGame.Analysis.normalizedTrace P).re ∧
            ThomGame.Analysis.matrixCoordinateEnergy U F ≤ α * (ThomGame.Analysis.normalizedTrace P).re
