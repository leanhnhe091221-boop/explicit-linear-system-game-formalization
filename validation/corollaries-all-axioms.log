ThomGame.Pictures.PortGraph.SunSpoke.sun_rim_cut_connected_iff {n : ℕ} {b : Fin n → ZMod 2} {u v : List (Fin n ⊕ Fin n)}
  {G : ThomGame.Pictures.PortGraph (ThomGame.Pictures.sunPresentation n b) u v} (s : G.SunSpoke) (hn : 3 ≤ n)
  (hu : ∀ z ∈ u, ∃ j, z = Sum.inl j) (hv : ∀ z ∈ v, ∃ j, z = Sum.inl j) (a : G.SunRimDart hn) (x y : G.Dart) :
  have C := G.sunRimSimpleCircuit hn hu hv a;
  have q := s.spokeDeletedPairing (fun z => ¬C.Marked z) ⋯;
  ThomGame.Pictures.RibbonConnectivity.Connected G.circuitStep C.cutPairing x y ↔
    ThomGame.Pictures.RibbonConnectivity.Connected G.circuitStep q x y ∨
      ThomGame.Pictures.RibbonConnectivity.Connected G.circuitStep q x
            (G.circuitStep (ThomGame.Pictures.Port.hub s.left 0)) ∧
          ThomGame.Pictures.RibbonConnectivity.Connected G.circuitStep q y
            (G.circuitStep (ThomGame.Pictures.Port.hub s.right 0)) ∨
        ThomGame.Pictures.RibbonConnectivity.Connected G.circuitStep q x
            (G.circuitStep (ThomGame.Pictures.Port.hub s.right 0)) ∧
          ThomGame.Pictures.RibbonConnectivity.Connected G.circuitStep q y
            (G.circuitStep (ThomGame.Pictures.Port.hub s.left 0))
