  (hL : ↑L ≤ Filter.atTop) (κ : ℝ) (hgap : ThomGame.Analysis.MatrixMarkovSpectralGap dims U hd L κ) :
  ∃ T Q,
    (∀ (k : ℕ) (i : Fin (Q k).n), (Q k).E i ≠ 0) ∧
      (∀ (k : ℕ), (Q k).n ≤ dims k) ∧
        Filter.Tendsto (fun k => ∑ j, ThomGame.Analysis.hsNorm (↑(T k j) - ↑(Fin.append (U k) (U k) j)) ^ 2) (↑L)
            (nhds 0) ∧
          (∀ (j : Fin (h + h)),
              ThomGame.Analysis.matrixTupleClass dims T (↑L) j =
                ThomGame.Analysis.matrixTupleClass dims (fun k => Fin.append (U k) (U k)) (↑L) j) ∧
            ThomGame.Analysis.matrixInternalQuotient dims
                  (fun k => ThomGame.Analysis.matrixPartitionScalarAlgebra (Q k).E) ↑L ≤
                ThomGame.Analysis.matrixRelativeCommutant dims U ↑L ∧
              StarSubalgebra.centralizer ℂ
                  ↑(ThomGame.Analysis.matrixInternalQuotient dims
                      (fun k => ThomGame.Analysis.matrixPartitionScalarAlgebra (Q k).E) ↑L) =
                ThomGame.Analysis.matrixInternalQuotient dims
                  (fun k => ThomGame.Analysis.matrixPartitionBlockAlgebra (Q k).E) ↑L
