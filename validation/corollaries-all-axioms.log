ThomGame.Analysis.exists_monotone_positive_operator_limit.{u_1, u_2} {H : Type u_1} [NormedAddCommGroup H]
  [InnerProductSpace ℂ H] {κ : Type u_2} [CompleteSpace H] [Preorder κ] [IsDirectedOrder κ] [Nonempty κ]
  (f : κ → H →L[ℂ] H) (hmono : Monotone f) (hpos : ∀ (i : κ), 0 ≤ f i) (K : ℝ) (hK : 0 ≤ K)
  (hbound : ∀ (i : κ), ‖f i‖ ≤ K) :
  ∃ T,
    0 ≤ T ∧
      ‖T‖ ≤ K ∧
        IsLUB (Set.range f) T ∧
          (∀ (x : H), Filter.Tendsto (fun i => (f i) x) Filter.atTop (nhds (T x))) ∧
            Filter.Tendsto (fun i => ContinuousLinearMapWOT.ofCLM (f i)) Filter.atTop
              (nhds (ContinuousLinearMapWOT.ofCLM T))
