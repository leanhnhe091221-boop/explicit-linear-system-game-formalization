ThomGame.Analysis.matrixInternalDiagonal_centralizer.{u_1, u_2} {ι : Type u_1} (dims : ι → ℕ) {μ : ι → Type u_2}
  [(k : ι) → Fintype (μ k)] (E : (k : ι) → μ k → ThomGame.Analysis.CMatrix (dims k))
  (hE : ∀ (k : ι) (i : μ k), IsStarProjection (E k i)) (horth : ∀ (k : ι), Pairwise fun i j => E k i * E k j = 0)
  (hsum : ∀ (k : ι), ∑ i, E k i = 1) (L : Filter ι) (hd : ∀ (k : ι), 0 < dims k) :
  StarSubalgebra.centralizer ℂ
      ↑(ThomGame.Analysis.matrixInternalQuotient dims (fun k => ThomGame.Analysis.matrixPartitionScalarAlgebra (E k))
