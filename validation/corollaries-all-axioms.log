ThomGame.Pictures.PortGraph.SunSpoke.switch_spoke_restored_connected_iff {n : ℕ} {b : Fin n → ZMod 2}
  {u v : List (Fin n ⊕ Fin n)} {G : ThomGame.Pictures.PortGraph (ThomGame.Pictures.sunPresentation n b) u v}
  (s : G.SunSpoke) (M : G.Dart → Prop)
  (hM :
    ∀ (x : ThomGame.Pictures.Port (ThomGame.Pictures.sunPresentation n b) u v G.Hub G.Joint G.hubLabel),
      M (G.pairing.twin x) ↔ M x)
  (hf : G.hubFlip s.left = G.hubFlip s.right) (hMa : M (ThomGame.Pictures.Port.hub s.left 0)) (x y : Subtype s.Kept) :
  ThomGame.Pictures.RibbonConnectivity.Connected s.switch.circuitStep
      (ThomGame.Pictures.RotationEuler.retainEdges s.switch.pairing.perm (fun z => M (s.portSwap z)) ⋯) (s.portSwap ↑x)
      (s.portSwap ↑y) ↔
    ThomGame.Pictures.RibbonConnectivity.Connected G.circuitStep (s.spokeDeletedPairing M hM) ↑x ↑y ∨
      ThomGame.Pictures.RibbonConnectivity.Connected G.circuitStep (s.spokeDeletedPairing M hM) (↑x)
            (s.portSwap (s.switch.circuitStep (ThomGame.Pictures.Port.hub s.left 0))) ∧
          ThomGame.Pictures.RibbonConnectivity.Connected G.circuitStep (s.spokeDeletedPairing M hM) (↑y)
            (s.portSwap (s.switch.circuitStep (ThomGame.Pictures.Port.hub s.right 0))) ∨
        ThomGame.Pictures.RibbonConnectivity.Connected G.circuitStep (s.spokeDeletedPairing M hM) (↑x)
            (s.portSwap (s.switch.circuitStep (ThomGame.Pictures.Port.hub s.right 0))) ∧
          ThomGame.Pictures.RibbonConnectivity.Connected G.circuitStep (s.spokeDeletedPairing M hM) (↑y)
            (s.portSwap (s.switch.circuitStep (ThomGame.Pictures.Port.hub s.left 0)))
