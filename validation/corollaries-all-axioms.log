def ThomGame.Analysis.IsApproxRepresentation.{u_1} : {S : Type u_1} →
  {d : ℕ} → Set (FreeGroup S) → ℝ → ThomGame.Analysis.MatrixAssignment S d → Prop :=
fun {S} {d} rels δ f => ∀ r ∈ rels, ThomGame.Analysis.unitaryLength (f r) ≤ δ
def ThomGame.Analysis.ApproximatelyTrivial.{u_1} : {S : Type u_1} → Set (FreeGroup S) → FreeGroup S → Prop :=
fun {S} rels v =>
  ∀ (η : ℝ),
    0 < η →
      ∃ δ,
        0 < δ ∧
          ∀ (d : ℕ),
            0 < d →
              ∀ (f : ThomGame.Analysis.MatrixAssignment S d),
                ThomGame.Analysis.IsApproxRepresentation rels δ f → ThomGame.Analysis.unitaryLength (f v) < η
def ThomGame.Analysis.nullUnitarySubgroup.{u_1} : {ι : Type u_1} →
  (dims : ι → ℕ) → Filter ι → Subgroup (ThomGame.Analysis.UnitarySequence dims) :=
fun {ι} dims L =>
  { carrier := fun U => Filter.Tendsto (fun i => ThomGame.Analysis.unitaryLength (U i)) L (nhds 0), mul_mem' := ⋯,
    one_mem' := ⋯, inv_mem' := ⋯ }
@[reducible] def ThomGame.Analysis.UnitarySequenceQuotient.{u_1} : {ι : Type u_1} → (ι → ℕ) → Filter ι → Type u_1 :=
fun {ι} dims L => ThomGame.Analysis.UnitarySequence dims ⧸ ThomGame.Analysis.nullUnitarySubgroup dims L
structure ThomGame.Analysis.ApproximationCountersequence.{u_1} {S : Type u_1} (rels : Set (FreeGroup S))
  (v : FreeGroup S) : Type u_1
number of parameters: 3
fields:
  ThomGame.Analysis.ApproximationCountersequence.separation : ℝ
  ThomGame.Analysis.ApproximationCountersequence.separation_pos : 0 < self.separation
  ThomGame.Analysis.ApproximationCountersequence.dims : ℕ → ℕ
  ThomGame.Analysis.ApproximationCountersequence.dims_pos : ∀ (n : ℕ), 0 < self.dims n
  ThomGame.Analysis.ApproximationCountersequence.assignment : (n : ℕ) →
      ThomGame.Analysis.MatrixAssignment S (self.dims n)
  ThomGame.Analysis.ApproximationCountersequence.approximate : ∀ (n : ℕ),
      ThomGame.Analysis.IsApproxRepresentation rels (1 / (↑n + 1)) (self.assignment n)
  ThomGame.Analysis.ApproximationCountersequence.separated : ∀ (n : ℕ),
      self.separation ≤ ThomGame.Analysis.unitaryLength ((self.assignment n) v)
constructor:
  ThomGame.Analysis.ApproximationCountersequence.mk.{u_1} {S : Type u_1} {rels : Set (FreeGroup S)} {v : FreeGroup S}
    (separation : ℝ) (separation_pos : 0 < separation) (dims : ℕ → ℕ) (dims_pos : ∀ (n : ℕ), 0 < dims n)
    (assignment : (n : ℕ) → ThomGame.Analysis.MatrixAssignment S (dims n))
    (approximate : ∀ (n : ℕ), ThomGame.Analysis.IsApproxRepresentation rels (1 / (↑n + 1)) (assignment n))
    (separated : ∀ (n : ℕ), separation ≤ ThomGame.Analysis.unitaryLength ((assignment n) v)) :
    ThomGame.Analysis.ApproximationCountersequence rels v
def ThomGame.Construction.SigmaApproximatelyTrivial : Prop :=
ThomGame.Analysis.ApproximatelyTrivial (ThomGame.SolutionGroup.relators ThomGame.Construction.numberedSystem)
  (FreeGroup.of none)
