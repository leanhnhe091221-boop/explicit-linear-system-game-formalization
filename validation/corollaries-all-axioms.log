ThomGame.Analysis.matrixResolvent_unitary_family_bound_initial {d : ℕ} [NeZero d] {lam : ℝ}
  {P : ThomGame.Analysis.CMatrix d} (hlam : 0 < lam) (hlam1 : lam ≤ 1) (hP : IsStarProjection P)
  (F : ℕ → ThomGame.Analysis.CMatrix d) (hF : ∀ (i : ℕ), IsStarProjection (F i))
  (U : ↥(ThomGame.Analysis.UnitaryMatrix d)) (n : ℕ) :
  ∑ i ∈ Finset.range n,
      ThomGame.Analysis.hsNorm
          ((↑U * ThomGame.Analysis.matrixPositiveResolvent lam (ThomGame.Analysis.matrixProjectionPartialSum P F i) -
              ThomGame.Analysis.matrixPositiveResolvent lam (ThomGame.Analysis.matrixProjectionPartialSum P F i) * ↑U) *
            F i) ^
        2 ≤
    292 / lam ^ 3 *
      (ThomGame.Analysis.hsNorm (↑U * P - P * ↑U) ^ 2 +
        ∑ i ∈ Finset.range n, ThomGame.Analysis.hsNorm (↑U * F i - F i * ↑U) ^ 2)
ThomGame.Analysis.hsNorm_resolventSqrt_commutator_le {d : ℕ} {A : ThomGame.Analysis.CMatrix d} (hA : 0 ≤ A)
  (X : ThomGame.Analysis.CMatrix d) :
  ThomGame.Analysis.hsNorm
      (X * CFC.sqrt (ThomGame.Analysis.matrixPositiveResolvent 1 A) -
        CFC.sqrt (ThomGame.Analysis.matrixPositiveResolvent 1 A) * X) ≤
    1 / 2 * ThomGame.Analysis.hsNorm (X * A - A * X)
ThomGame.Analysis.matrixProjectionResolventFactor_norm_le {d : ℕ} {lam : ℝ} {S F : ThomGame.Analysis.CMatrix d}
  (hlam : 0 < lam) (hS : 0 ≤ S) (hF : IsStarProjection F) :
  ThomGame.Analysis.matrixOpNorm (ThomGame.Analysis.matrixProjectionResolventFactor lam S F) ≤ 1
ThomGame.Analysis.hsNorm_projection_resolvent_difference_commutator_sq_le {d : ℕ} {lam : ℝ}
  {S F : ThomGame.Analysis.CMatrix d} (hlam : 0 < lam) (hlam1 : lam ≤ 1) (hS : 0 ≤ S) (hF : IsStarProjection F)
  (U : ↥(ThomGame.Analysis.UnitaryMatrix d)) :
  ThomGame.Analysis.hsNorm
        (↑U * ThomGame.Analysis.matrixProjectionResolventDifference lam S F -
          ThomGame.Analysis.matrixProjectionResolventDifference lam S F * ↑U) ^
      2 ≤
    32 / lam ^ 3 * ThomGame.Analysis.hsNorm (↑U * F - F * ↑U) ^ 2 +
      32 / lam *
        ThomGame.Analysis.hsNorm
            ((↑U * ThomGame.Analysis.matrixPositiveResolvent lam S -
                ThomGame.Analysis.matrixPositiveResolvent lam S * ↑U) *
              F) ^
          2
ThomGame.Analysis.matrixResolventDifferenceFamily_energy_sum_le {d h : ℕ} [NeZero d] {lam : ℝ}
  {P : ThomGame.Analysis.CMatrix d} (hlam : 0 < lam) (hlam1 : lam ≤ 1) (hP : IsStarProjection P)
  (F : ℕ → ThomGame.Analysis.CMatrix d) (hF : ∀ (i : ℕ), IsStarProjection (F i))
  (U : Fin h → ↥(ThomGame.Analysis.UnitaryMatrix d)) (n : ℕ) :
  ∑ i ∈ Finset.range n,
      ThomGame.Analysis.matrixCoordinateEnergy U (ThomGame.Analysis.matrixResolventDifferenceFamily lam P F i) ≤
    9376 / lam ^ 4 *
      (ThomGame.Analysis.matrixCoordinateEnergy U P +
        ∑ i ∈ Finset.range n, ThomGame.Analysis.matrixCoordinateEnergy U (F i))
ThomGame.Analysis.exists_matrixResolventSmallEnergyRounding {d h : ℕ} [NeZero d] [NeZero h] {γ : ℝ}
  {P : ThomGame.Analysis.CMatrix d} (hγ : 0 < γ) (hγ1 : γ ≤ 1) (hP : IsStarProjection P)
  (F : ℕ → ThomGame.Analysis.CMatrix d) (hF : ∀ (i : ℕ), IsStarProjection (F i))
  (U : Fin h → ↥(ThomGame.Analysis.UnitaryMatrix d)) (n : ℕ)
  (htrace :
    (ThomGame.Analysis.normalizedTrace P).re + ∑ i ∈ Finset.range n, (ThomGame.Analysis.normalizedTrace (F i)).re ≤ 3)
  (henergy :
    ThomGame.Analysis.matrixCoordinateEnergy U P +
        ∑ i ∈ Finset.range n, ThomGame.Analysis.matrixCoordinateEnergy U (F i) ≤
      γ ^ 16) :
  ∃ s ∈ Set.Icc γ (2 * γ),
    (∀ (i : Fin n),
        IsStarProjection (ThomGame.Analysis.matrixResolventSpectralProjection (γ ^ 2) P F s ↑i) ∧
          Matrix.rank (ThomGame.Analysis.matrixResolventSpectralProjection (γ ^ 2) P F s ↑i) ≤ Matrix.rank (F ↑i)) ∧
      ∑ i,
            ThomGame.Analysis.matrixCoordinateEnergy U
              (ThomGame.Analysis.matrixResolventSpectralProjection (γ ^ 2) P F s ↑i) ≤
          100 * γ ^ 2 ∧
        ∑ i,
              (ThomGame.Analysis.normalizedTrace
                  (ThomGame.Analysis.matrixProjectionPartialSum P F ↑i ^ 2 *
                    ThomGame.Analysis.matrixResolventSpectralProjection (γ ^ 2) P F s ↑i)).re ≤
            3 * γ ∧
          (ThomGame.Analysis.matrixFamilyCoverageDefect fun i =>
              ThomGame.Analysis.matrixResolventSpectralProjection (γ ^ 2) P F s ↑i) ≤
            (ThomGame.Analysis.normalizedTrace P).re +
                (ThomGame.Analysis.normalizedTrace
                    (1 -
                      ThomGame.Analysis.matrixSpectralCut (ThomGame.Analysis.matrixProjectionPartialSum P F n) γ)).re +
              7 * γ
ThomGame.Analysis.exists_matrixProjectionFamily_ALT_lemma3_3 {d h : ℕ} [NeZero d] [NeZero h] {γ : ℝ}
  {e : ThomGame.Analysis.CMatrix d} (hγ : 0 < γ) (hγ4 : γ ≤ 1 / 4) (he : IsStarProjection e)
  (F : ℕ → ThomGame.Analysis.CMatrix d) (hF : ∀ (i : ℕ), IsStarProjection (F i))
  (U : Fin h → ↥(ThomGame.Analysis.UnitaryMatrix d)) (n : ℕ)
  (htrace :
    (ThomGame.Analysis.normalizedTrace (1 - e)).re +
        ∑ i ∈ Finset.range n, (ThomGame.Analysis.normalizedTrace (F i)).re ≤
      3)
  (henergy :
    ThomGame.Analysis.matrixCoordinateEnergy U (1 - e) +
        ∑ i ∈ Finset.range n, ThomGame.Analysis.matrixCoordinateEnergy U (F i) ≤
      γ ^ 16) :
  ∃ Q,
    (∀ (i : Fin n), IsStarProjection (Q i) ∧ Matrix.rank (Q i) ≤ Matrix.rank (F ↑i)) ∧
      ∑ i, ThomGame.Analysis.matrixCoordinateEnergy U (Q i) ≤ 100 * γ ^ 2 ∧
        ∑ i,
              (ThomGame.Analysis.normalizedTrace
                  (ThomGame.Analysis.matrixProjectionPartialSum (1 - e) F ↑i ^ 2 * Q i)).re ≤
            3 * γ ∧
          ThomGame.Analysis.matrixFamilyCoverageDefect Q ≤
            (ThomGame.Analysis.normalizedTrace (1 - e)).re +
                (ThomGame.Analysis.normalizedTrace
                    (ThomGame.Analysis.matrixClosedLowSpectralCut
                      (ThomGame.Analysis.matrixProjectionPartialSum (1 - e) F n) γ)).re +
              7 * γ
ThomGame.Analysis.matrixResolvent_unitary_finite_family_bound {d n : ℕ} [NeZero d] {lam : ℝ} (hlam : 0 < lam)
  (hlam1 : lam ≤ 1) (F : Fin n → ThomGame.Analysis.CMatrix d) (hF : ∀ (i : Fin n), IsStarProjection (F i))
  (U : ↥(ThomGame.Analysis.UnitaryMatrix d)) :
  ∑ i,
      ThomGame.Analysis.hsNorm
          ((↑U *
                ThomGame.Analysis.matrixPositiveResolvent lam
                  (ThomGame.Analysis.matrixProjectionPartialSum 0 (ThomGame.Analysis.matrixExtendFiniteFamily F) ↑i) -
              ThomGame.Analysis.matrixPositiveResolvent lam
                  (ThomGame.Analysis.matrixProjectionPartialSum 0 (ThomGame.Analysis.matrixExtendFiniteFamily F) ↑i) *
                ↑U) *
            F i) ^
        2 ≤
    292 / lam ^ 3 * ∑ i, ThomGame.Analysis.hsNorm (↑U * F i - F i * ↑U) ^ 2
ThomGame.Analysis.exists_matrixFiniteProjectionFamily_ALT_lemma3_3 {d n h : ℕ} [NeZero d] [NeZero h] {γ : ℝ}
  {e : ThomGame.Analysis.CMatrix d} (hγ : 0 < γ) (hγ4 : γ ≤ 1 / 4) (he : IsStarProjection e)
  (F : Fin n → ThomGame.Analysis.CMatrix d) (hF : ∀ (i : Fin n), IsStarProjection (F i))
  (U : Fin h → ↥(ThomGame.Analysis.UnitaryMatrix d))
  (htrace : (ThomGame.Analysis.normalizedTrace (1 - e)).re + ∑ i, (ThomGame.Analysis.normalizedTrace (F i)).re ≤ 3)
  (henergy :
    ThomGame.Analysis.matrixCoordinateEnergy U (1 - e) + ∑ i, ThomGame.Analysis.matrixCoordinateEnergy U (F i) ≤
      γ ^ 16) :
  ∃ Q,
    (∀ (i : Fin n), IsStarProjection (Q i) ∧ Matrix.rank (Q i) ≤ Matrix.rank (F i)) ∧
      ∑ i, ThomGame.Analysis.matrixCoordinateEnergy U (Q i) ≤ 100 * γ ^ 2 ∧
        ∑ i,
              (ThomGame.Analysis.normalizedTrace
                  (ThomGame.Analysis.matrixProjectionPartialSum (1 - e) (ThomGame.Analysis.matrixExtendFiniteFamily F)
                        ↑i ^
                      2 *
                    Q i)).re ≤
            3 * γ ∧
          ThomGame.Analysis.matrixFamilyCoverageDefect Q ≤
            (ThomGame.Analysis.normalizedTrace (1 - e)).re +
                (ThomGame.Analysis.normalizedTrace
                    (ThomGame.Analysis.matrixClosedLowSpectralCut (1 - e + ∑ i, F i) γ)).re +
              7 * γ
