  {H : ThomGame.Construction.SigmaGraph [] []} (t : ThomGame.Construction.SigmaGraphWitness d H) [IsEmpty H.Joint]
  (hmin : ThomGame.Pictures.Diagram.Minimal d) (hs : ThomGame.Pictures.Diagram.sign d = 1)
  (i : ThomGame.Construction.WheelCycleIndex)
  (a : ThomGame.Pictures.PortGraph.RimDart H (ThomGame.Construction.numberedWheelCycles i)) (s : Bool)
  (m : ThomGame.Construction.GermSunRelabelling t i a s)
  (hw :
    List.map m.edge ((ThomGame.Construction.closedSigmaRimCircuit H i a).frontierWord !s) =
      ThomGame.Construction.closedSigmaRimSunFrontierWord H i a !s)
  {K :
    ThomGame.Pictures.PortGraph
      (ThomGame.Pictures.sunPresentation (ThomGame.Construction.wheelCycles i).length fun x => 0) []
      (List.map m.edge ((ThomGame.Construction.closedSigmaRimCircuit H i a).frontierWord !s)).reverse}
  (q : (ThomGame.Construction.germSunInitialGraph t i a s m).SunSwitchTrace K)
  (L :
    ThomGame.Construction.IncludedWheelSun i K
      ((ThomGame.Construction.closedSigmaRimCircuit H i a).frontierWord !s).reverse)
  (hp :
    ∀ (x : (ThomGame.Pictures.PortGraph.swapBoundary (ThomGame.Construction.smoothedSigmaRimGermGraph t i a s)).Dart),
      (ThomGame.Construction.numberedWheelCycleRetraction i).retract.edge
          (ThomGame.Pictures.Port.label
            (ThomGame.Pictures.PortGraph.swapBoundary
                (ThomGame.Construction.smoothedSigmaRimGermGraph t i a s)).jointLabel
            x) =
        some
          (m.edge
            (ThomGame.Pictures.Port.label
              (ThomGame.Pictures.PortGraph.swapBoundary
                  (ThomGame.Construction.smoothedSigmaRimGermGraph t i a s)).jointLabel
              x))) :
  Prop
ThomGame.Construction.smoothedSigmaRim_exists_face_preserving_normalization
  {d : ThomGame.Construction.SigmaDiagram [] []} {H : ThomGame.Construction.SigmaGraph [] []}
  (t : ThomGame.Construction.SigmaGraphWitness d H) [IsEmpty H.Joint] (hmin : ThomGame.Pictures.Diagram.Minimal d)
  (hs : ThomGame.Pictures.Diagram.sign d = 1) (i : ThomGame.Construction.WheelCycleIndex)
  (a : ThomGame.Pictures.PortGraph.RimDart H (ThomGame.Construction.numberedWheelCycles i))
  (hi : i ≠ ThomGame.Construction.oddWheelCycle) :
  ∃ side m,
    ∃ (hw :
      List.map m.edge ((ThomGame.Construction.closedSigmaRimCircuit H i a).frontierWord !side) =
        ThomGame.Construction.closedSigmaRimSunFrontierWord H i a !side),
      ∃ K q L,
        ∃ (hp :
          ∀
            (x :
              (ThomGame.Pictures.PortGraph.swapBoundary
                  (ThomGame.Construction.smoothedSigmaRimGermGraph t i a side)).Dart),
            (ThomGame.Construction.numberedWheelCycleRetraction i).retract.edge
                (ThomGame.Pictures.Port.label
                  (ThomGame.Pictures.PortGraph.swapBoundary
                      (ThomGame.Construction.smoothedSigmaRimGermGraph t i a side)).jointLabel
                  x) =
              some
                (m.edge
                  (ThomGame.Pictures.Port.label
                    (ThomGame.Pictures.PortGraph.swapBoundary
                        (ThomGame.Construction.smoothedSigmaRimGermGraph t i a side)).jointLabel
                    x))),
          ThomGame.Pictures.PortGraph.SunSwitchTrace.Inward ⋯ ⋯ q ∧
            ThomGame.Pictures.PortGraph.SunFaceState ⋯ ⋯ K ∧
              ThomGame.Construction.GermSunPreservesOriginalCrossingFaces t hmin hs i a side m hw q L hp ∧
                ThomGame.Construction.GermSunPreservesExteriorFaces t hmin hs i a side m hw q L hp ∧
                  ∑ h, ↑[L.graph.hubLabel h] =
                      Multiset.map (⇑(ThomGame.Construction.numberedWheelSunEmbedding i).vertex)
                        (Multiset.filterMap (ThomGame.Construction.numberedWheelCycleRetraction i).retract.vertex
                          (∑ h, ↑[(ThomGame.Construction.smoothedSigmaRimGermGraph t i a side).hubLabel h])) ∧
                    Fintype.card
                          (L.orientedGlue (ThomGame.Construction.smoothedSigmaRimRegionGraph t i a !side)).graph.Hub =
                        ThomGame.Pictures.Diagram.size d ∧
                      (L.orientedGlue (ThomGame.Construction.smoothedSigmaRimRegionGraph t i a !side)).graph.sign = 1 ∧
                        ThomGame.Pictures.RibbonConnectivity.eulerDefect
                              (L.orientedGlue
                                      (ThomGame.Construction.smoothedSigmaRimRegionGraph t i a
                                        !side)).graph.pairing.perm
                              (L.orientedGlue
                                    (ThomGame.Construction.smoothedSigmaRimRegionGraph t i a !side)).graph.circuitStep =
                            0 ∧
                          ∃ f,
                            ↑(ThomGame.Pictures.Diagram.labels f) =
                                ∑ h,
                                  ↑[(L.orientedGlue
                                              (ThomGame.Construction.smoothedSigmaRimRegionGraph t i a
                                                !side)).graph.hubLabel
                                        h] ∧
                              ThomGame.Pictures.Diagram.size f = ThomGame.Pictures.Diagram.size d ∧
                                ThomGame.Pictures.Diagram.sign f = 1 ∧ ThomGame.Pictures.Diagram.Minimal f
