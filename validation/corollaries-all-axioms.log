ThomGame.Analysis.matrixPartitionRange_joint_expectation.{u_1, u_2, u_3} {ι : Type u_1} {κ : Type u_2} {μ : Type u_3}
  [Fintype ι] [Fintype κ] [Fintype μ] [DecidableEq ι] [DecidableEq κ] [DecidableEq μ] (r : ℕ) (E : μ → Matrix ι ι ℂ)
  (hE : ∀ (i : μ), IsStarProjection (E i)) (horth : ∀ (i j : μ), i ≠ j → E i * E j = 0) (Y : Matrix ι κ ℂ) (t : ℝ) :
  t *
      ∫ (s : μ → ℝ),
        ∑ j,
          (1 - s j ^ 2) *
            ThomGame.Analysis.matrixProjectionMixing r (E j)
              (ThomGame.Analysis.matrixPartitionRange E Y t s) ∂ThomGame.Analysis.uniformCubeMeasure =
    ∫ (s : μ → ℝ),
      ThomGame.Analysis.matrixTraceReal r
        (ThomGame.Analysis.matrixProjectionParameter E s *
          ThomGame.Analysis.matrixPartitionRange E Y t s) ∂ThomGame.Analysis.uniformCubeMeasure
ThomGame.Analysis.matrixPartitionRange_weighted_expectation_le_one.{u_1, u_2, u_3} {ι : Type u_1} {κ : Type u_2}
  {μ : Type u_3} [Fintype ι] [Fintype κ] [Fintype μ] [DecidableEq ι] [DecidableEq κ] [DecidableEq μ]
  (E : μ → Matrix ι ι ℂ) (hE : ∀ (i : μ), IsStarProjection (E i)) (horth : ∀ (i j : μ), i ≠ j → E i * E j = 0)
  (hsum : ∑ i, E i = 1) {Y : Matrix ι κ ℂ} (hY : IsStarProjection (Y.conjTranspose * Y)) (t : ℝ) :
  t *
      ∫ (s : μ → ℝ),
        ∑ j,
          (1 - s j ^ 2) *
            ThomGame.Analysis.matrixProjectionMixing (Fintype.card κ) (E j)
              (ThomGame.Analysis.matrixPartitionRange E Y t s) ∂ThomGame.Analysis.uniformCubeMeasure ≤
    1
ThomGame.Analysis.uniformCube_mixing_expectation_le.{u_1} {μ : Type u_1} [Fintype μ] (m : μ → (μ → ℝ) → ℝ) (M : μ → ℝ)
  (hc : ∀ (j : μ), Continuous (m j)) (hm : ∀ s ∈ ThomGame.Analysis.uniformCube, ∀ (j : μ), 0 ≤ m j s)
  (hM : ∀ s ∈ ThomGame.Analysis.uniformCube, ∀ (j : μ), m j s ≤ M j) {t ε : ℝ} (ht : 0 < t) (hε : 0 < ε) (hε1 : ε ≤ 1)
  (hweighted : t * ∫ (s : μ → ℝ), ∑ j, (1 - s j ^ 2) * m j s ∂ThomGame.Analysis.uniformCubeMeasure ≤ 1) :
  ∫ (s : μ → ℝ), ∑ j, m j s ∂ThomGame.Analysis.uniformCubeMeasure ≤ (t * ε)⁻¹ + ε * ∑ j, M j
ThomGame.Analysis.matrixPartitionRange_defect_expectation_le.{u_1, u_2, u_3} {ι : Type u_1} {κ : Type u_2}
  {μ : Type u_3} [Fintype ι] [Fintype κ] [Fintype μ] [DecidableEq ι] [DecidableEq κ] [DecidableEq μ]
  (E : μ → Matrix ι ι ℂ) (hE : ∀ (i : μ), IsStarProjection (E i)) (horth : ∀ (i j : μ), i ≠ j → E i * E j = 0)
  (hsum : ∑ i, E i = 1) (hdim : Fintype.card ι ≤ 3 * Fintype.card κ) {Y : Matrix ι κ ℂ}
  (hY : IsStarProjection (Y.conjTranspose * Y)) {t ε : ℝ} (ht : 0 < t) (hε : 0 < ε) (hε1 : ε ≤ 1) :
  ∫ (s : μ → ℝ),
      ThomGame.Analysis.rectHSNorm (Fintype.card κ)
          (ThomGame.Analysis.matrixPartitionRange E Y t s -
            ThomGame.Analysis.matrixBlockPinch E (ThomGame.Analysis.matrixPartitionRange E Y t s)) ^
        2 ∂ThomGame.Analysis.uniformCubeMeasure ≤
    (t * ε)⁻¹ + 3 * ε
ThomGame.Analysis.exists_matrixPartitionRange_small_defect.{u_1, u_2, u_3} {ι : Type u_1} {κ : Type u_2} {μ : Type u_3}
  [Fintype ι] [Fintype κ] [Fintype μ] [DecidableEq ι] [DecidableEq κ] [DecidableEq μ] (E : μ → Matrix ι ι ℂ)
  (hE : ∀ (i : μ), IsStarProjection (E i)) (horth : ∀ (i j : μ), i ≠ j → E i * E j = 0) (hsum : ∑ i, E i = 1)
  (hdim : Fintype.card ι ≤ 3 * Fintype.card κ) {Y : Matrix ι κ ℂ} (hY : IsStarProjection (Y.conjTranspose * Y)) {t : ℝ}
  (ht : 1 ≤ t) :
  ∃ s,
    (∀ (i : μ), |s i| ≤ 1) ∧
      ThomGame.Analysis.rectHSNorm (Fintype.card κ)
            (ThomGame.Analysis.matrixPartitionRange E Y t s -
              ThomGame.Analysis.matrixBlockPinch E (ThomGame.Analysis.matrixPartitionRange E Y t s)) ^
          2 ≤
        4 * (√t)⁻¹
ThomGame.Analysis.exists_matrixPartitionPolarTilt_good_parameter.{u_1, u_2, u_3} {ι : Type u_1} {κ : Type u_2}
  {μ : Type u_3} [Fintype ι] [Fintype κ] [Fintype μ] [DecidableEq ι] [DecidableEq κ] [DecidableEq μ] {h : ℕ}
  (U : Fin h → ↥(Matrix.unitaryGroup κ ℂ)) (V : Fin h → ↥(Matrix.unitaryGroup ι ℂ)) (E : μ → Matrix ι ι ℂ)
  (hE : ∀ (i : μ), IsStarProjection (E i)) (horth : ∀ (i j : μ), i ≠ j → E i * E j = 0) (hsum : ∑ i, E i = 1)
  (hdim : Fintype.card ι ≤ 3 * Fintype.card κ) (hcomm : ∀ (j : Fin h) (i : μ), ↑(V j) * E i = E i * ↑(V j))
  {Y : Matrix ι κ ℂ} (hY : IsStarProjection (Y.conjTranspose * Y)) {t : ℝ} (ht : 1 ≤ t) :
  ∃ s,
    (∀ (i : μ), |s i| ≤ 1) ∧
      have YA := ThomGame.Analysis.matrixExponentialPolarTilt t (ThomGame.Analysis.matrixProjectionParameter E s) Y;
      YA.conjTranspose * YA = Y.conjTranspose * Y ∧
        ThomGame.Analysis.rectHSNorm (Fintype.card κ)
                (YA * YA.conjTranspose - ThomGame.Analysis.matrixBlockPinch E (YA * YA.conjTranspose)) ^
              2 ≤
            4 * (√t)⁻¹ ∧
          ThomGame.Analysis.matrixIntertwiningEnergy (Fintype.card κ) U V YA ≤
            Real.exp (4 * t) * ThomGame.Analysis.matrixIntertwiningEnergy (Fintype.card κ) U V Y
