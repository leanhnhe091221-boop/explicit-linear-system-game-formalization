ThomGame.Analysis.matrixHalfProjection_eq_closed_interval.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι]
  {A : Matrix ι ι ℂ} (hA : A.IsHermitian) (hA1 : A ≤ 1) :
  ThomGame.Analysis.matrixHalfProjection A = cfc (fun x => if 1 / 2 ≤ x ∧ x ≤ 1 then 1 else 0) A
ThomGame.Analysis.exists_matrixBlockProjection_rank.{u_1, u_2} {ι : Type u_1} {μ : Type u_2} [Fintype ι] [Fintype μ]
  [DecidableEq ι] (E : μ → Matrix ι ι ℂ) (hE : ∀ (i : μ), IsStarProjection (E i))
  (horth : ∀ (i j : μ), i ≠ j → E i * E j = 0) (hsum : ∑ i, E i = 1) {Q : Matrix ι ι ℂ} (hQ : IsStarProjection Q)
  (hcomm : ∀ (i : μ), Commute (E i) Q) (n : ℕ) (hn : n ≤ Fintype.card ι) :
  ∃ R, IsStarProjection R ∧ R.rank = n ∧ (R ≤ Q ∨ Q ≤ R) ∧ ∀ (i : μ), Commute (E i) R
ThomGame.Analysis.exists_matrixPinching_rank_corrected.{u_1, u_2} {ι : Type u_1} {μ : Type u_2} [Fintype ι] [Fintype μ]
  [DecidableEq ι] (r : ℕ) (E : μ → Matrix ι ι ℂ) (hE : ∀ (i : μ), IsStarProjection (E i))
  (horth : ∀ (i j : μ), i ≠ j → E i * E j = 0) (hsum : ∑ i, E i = 1) {P : Matrix ι ι ℂ} (hP : IsStarProjection P) :
  ∃ R,
    IsStarProjection R ∧
      R.rank = P.rank ∧
        (∀ (i : μ), Commute (E i) R) ∧
          ThomGame.Analysis.rectHSNorm r (P - R) ^ 2 ≤
            4 * ThomGame.Analysis.rectHSNorm r (P - ThomGame.Analysis.matrixBlockPinch E P) ^ 2
ThomGame.Analysis.exists_matrixPolar_completion.{u_1, u_2} {ι : Type u_1} {κ : Type u_2} [Fintype ι] [Fintype κ]
  [DecidableEq ι] [DecidableEq κ] {X : Matrix ι κ ℂ} {P : Matrix κ κ ℂ} {Q : Matrix ι ι ℂ} (hP : IsStarProjection P)
  (hQ : IsStarProjection Q) (hrank : P.rank = Q.rank) (hXP : X * P = X) (hQX : Q * X = X) :
  ∃ Z, Z.conjTranspose * Z = P ∧ Z * Z.conjTranspose = Q ∧ Z.conjTranspose * X = ThomGame.Analysis.matrixRectAbs X
ThomGame.Analysis.exists_matrixPartialIsometry_close_to_projection.{u_1, u_2} {ι : Type u_1} {κ : Type u_2} [Fintype ι]
  [Fintype κ] [DecidableEq ι] [DecidableEq κ] (r : ℕ) {Y : Matrix ι κ ℂ} (hY : IsStarProjection (Y.conjTranspose * Y))
  {E : Matrix ι ι ℂ} (hE : IsStarProjection E) (hrank : E.rank = (Y * Y.conjTranspose).rank) :
  ∃ Z,
    Z.conjTranspose * Z = Y.conjTranspose * Y ∧
      Z * Z.conjTranspose = E ∧
        ThomGame.Analysis.rectHSNorm r (Z - Y) ^ 2 ≤ ThomGame.Analysis.rectHSNorm r (Y * Y.conjTranspose - E) ^ 2
ThomGame.Analysis.exists_matrixPartialIsometry_block_correction.{u_1, u_2, u_3} {ι : Type u_1} {κ : Type u_2}
  {μ : Type u_3} [Fintype ι] [Fintype κ] [Fintype μ] [DecidableEq ι] [DecidableEq κ] (r : ℕ) (E : μ → Matrix ι ι ℂ)
  (hE : ∀ (i : μ), IsStarProjection (E i)) (horth : ∀ (i j : μ), i ≠ j → E i * E j = 0) (hsum : ∑ i, E i = 1)
  {Y : Matrix ι κ ℂ} (hY : IsStarProjection (Y.conjTranspose * Y)) :
  ∃ Z,
    Z.conjTranspose * Z = Y.conjTranspose * Y ∧
      (∀ (i : μ), Commute (Z * Z.conjTranspose) (E i)) ∧
        ThomGame.Analysis.rectHSNorm r (Z - Y) ^ 2 ≤
          4 *
            ThomGame.Analysis.rectHSNorm r
                (Y * Y.conjTranspose - ThomGame.Analysis.matrixBlockPinch E (Y * Y.conjTranspose)) ^
              2
ThomGame.Analysis.exists_matrixPartialIsometry_ALT_lemma3_4.{u_1, u_2, u_3} {ι : Type u_1} {κ : Type u_2} {μ : Type u_3}
  [Fintype ι] [Fintype κ] [Fintype μ] [DecidableEq ι] [DecidableEq κ] [DecidableEq μ] {h : ℕ} [NeZero h]
  (U : Fin h → ↥(Matrix.unitaryGroup κ ℂ)) (V : Fin h → ↥(Matrix.unitaryGroup ι ℂ)) (E : μ → Matrix ι ι ℂ)
