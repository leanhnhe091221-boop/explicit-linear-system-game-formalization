def ThomGame.Pictures.PortGraph.partialDartSwap.{u_1, u_2} : {R : Type u_1} →
  {S : Type u_2} →
    {P : ThomGame.InvolutionPresentation R S} →
      {u v w : List S} →
        (G : ThomGame.Pictures.PortGraph P u v) →
          (H : ThomGame.Pictures.PortGraph P v w) → ℕ → Equiv.Perm (G.Dart ⊕ H.Dart) :=
fun {R} {S} {P} {u v w} G H k =>
  {
    toFun := fun x =>
      match x with
      | Sum.inl (ThomGame.Pictures.Port.bottom i) =>
        if ↑i < k then Sum.inr (ThomGame.Pictures.Port.top i) else Sum.inl (ThomGame.Pictures.Port.bottom i)
      | Sum.inr (ThomGame.Pictures.Port.top i) =>
        if ↑i < k then Sum.inl (ThomGame.Pictures.Port.bottom i) else Sum.inr (ThomGame.Pictures.Port.top i)
      | x => x,
    invFun := fun x =>
      match x with
      | Sum.inl (ThomGame.Pictures.Port.bottom i) =>
        if ↑i < k then Sum.inr (ThomGame.Pictures.Port.top i) else Sum.inl (ThomGame.Pictures.Port.bottom i)
      | Sum.inr (ThomGame.Pictures.Port.top i) =>
        if ↑i < k then Sum.inl (ThomGame.Pictures.Port.bottom i) else Sum.inr (ThomGame.Pictures.Port.top i)
      | x => x,
    left_inv := ⋯, right_inv := ⋯ }
def ThomGame.Pictures.PortGraph.FullSeamRemaining.{u_1, u_2} : {R : Type u_1} →
  {S : Type u_2} →
    {P : ThomGame.InvolutionPresentation R S} →
      {u v w : List S} →
        (G : ThomGame.Pictures.PortGraph P u v) →
          (H : ThomGame.Pictures.PortGraph P v w) → ℕ → G.Dart ⊕ H.Dart → Prop :=
fun {R} {S} {P} {u v w} G H k x =>
  match x with
  | Sum.inl (ThomGame.Pictures.Port.top i) => True
  | Sum.inl (ThomGame.Pictures.Port.bottom i) => k ≤ ↑i
  | Sum.inr (ThomGame.Pictures.Port.top i) => k ≤ ↑i
  | Sum.inr (ThomGame.Pictures.Port.bottom i) => True
  | x => False
def ThomGame.Pictures.PortGraph.fullPartialSeam.{u_1, u_2} : {R : Type u_1} →
  {S : Type u_2} →
    {P : ThomGame.InvolutionPresentation R S} →
      {u v w : List S} →
        (G : ThomGame.Pictures.PortGraph P u v) →
          (H : ThomGame.Pictures.PortGraph P v w) → ℕ → Equiv.Perm (G.Dart ⊕ H.Dart) :=
fun {R} {S} {P} {u v w} G H k => G.partialDartSwap H k * Equiv.sumCongr G.circuitStep H.circuitStep
def ThomGame.Pictures.PortGraph.numberedFullBoundary.{u_1, u_2} : {R : Type u_1} →
  {S : Type u_2} →
    {P : ThomGame.InvolutionPresentation R S} →
      {u v w : List S} →
        (G : ThomGame.Pictures.PortGraph P u v) →
          (H : ThomGame.Pictures.PortGraph P v w) →
            (k : ℕ) →
              Subtype (ThomGame.Pictures.PortGraph.numberedSeamRemaining u v w k) ≃ Subtype (G.FullSeamRemaining H k) :=
fun {R} {S} {P} {u v w} G H k =>
  (ThomGame.Pictures.PortGraph.numberedBoundaryPorts k).trans (G.remainingBoundaryPorts H k)
