ThomGame.Analysis.matrixFilledGram_range_formula.{u_1, u_2} {ι : Type u_1} {κ : Type u_2} [Fintype ι] [Fintype κ]
  [DecidableEq κ] (X : Matrix ι κ ℂ) :
  X * (ThomGame.Analysis.matrixFilledGram X)⁻¹ * X.conjTranspose =
    ThomGame.Analysis.matrixRectPolar X * (ThomGame.Analysis.matrixRectPolar X).conjTranspose
ThomGame.Analysis.matrixRangeProjection_hasDerivAt.{u_1, u_2} {ι : Type u_1} {κ : Type u_2} [Fintype ι] [Fintype κ]
  [DecidableEq ι] [DecidableEq κ] {X : ℝ → Matrix ι κ ℂ} {P : Matrix κ κ ℂ} {K : Matrix ι ι ℂ} (hK : K.IsHermitian)
  (hP : ∀ (a : ℝ), ThomGame.Analysis.matrixRealSupport (ThomGame.Analysis.matrixRectAbs (X a)) = P) {s : ℝ}
  (hX : HasDerivAt X (K * X s) s) :
  HasDerivAt (fun a => ThomGame.Analysis.matrixRangeProjection (X a))
    ((1 - ThomGame.Analysis.matrixRangeProjection (X s)) * K * ThomGame.Analysis.matrixRangeProjection (X s) +
      ThomGame.Analysis.matrixRangeProjection (X s) * K * (1 - ThomGame.Analysis.matrixRangeProjection (X s)))
    s
ThomGame.Analysis.matrixExponentialRange_hasDerivAt.{u_1, u_2} {ι : Type u_1} {κ : Type u_2} [Fintype ι] [Fintype κ]
  [DecidableEq ι] [DecidableEq κ] {A E : Matrix ι ι ℂ} (hA : A.IsHermitian) (hE : E.IsHermitian) (hAE : Commute A E)
  (Y : Matrix ι κ ℂ) (t s : ℝ) :
  HasDerivAt (fun a => ThomGame.Analysis.matrixExponentialRange t (A + a • E) Y)
    (t •
      ((1 - ThomGame.Analysis.matrixExponentialRange t (A + s • E) Y) * E *
          ThomGame.Analysis.matrixExponentialRange t (A + s • E) Y +
        ThomGame.Analysis.matrixExponentialRange t (A + s • E) Y * E *
          (1 - ThomGame.Analysis.matrixExponentialRange t (A + s • E) Y)))
    s
ThomGame.Analysis.matrixProjectionMixing_eq_source.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι] (r : ℕ)
  {E : Matrix ι ι ℂ} (hE : IsStarProjection E) (P : Matrix ι ι ℂ) :
  ThomGame.Analysis.matrixProjectionMixing r E P =
    ThomGame.Analysis.matrixTraceReal r (E * P) - ThomGame.Analysis.matrixTraceReal r ((E * P * E) ^ 2)
ThomGame.Analysis.matrixProjectionMixing_eq_hsNorm_sq.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι] (r : ℕ)
  {E P : Matrix ι ι ℂ} (hE : IsStarProjection E) (hP : IsStarProjection P) :
  ThomGame.Analysis.matrixProjectionMixing r E P = ThomGame.Analysis.rectHSNorm r ((1 - P) * E * P) ^ 2
ThomGame.Analysis.matrixPartitionRange_coordinate_derivative.{u_1, u_2, u_3} {ι : Type u_1} {κ : Type u_2}
  {μ : Type u_3} [Fintype ι] [Fintype κ] [Fintype μ] [DecidableEq ι] [DecidableEq κ] [DecidableEq μ]
  (E : μ → Matrix ι ι ℂ) (hE : ∀ (i : μ), IsStarProjection (E i)) (horth : ∀ (i j : μ), i ≠ j → E i * E j = 0)
  (Y : Matrix ι κ ℂ) (t : ℝ) (s : μ → ℝ) (j : μ) :
  HasDerivAt (fun a => ThomGame.Analysis.matrixPartitionRange E Y t (Function.update s j a))
    (t •
      ((1 - ThomGame.Analysis.matrixPartitionRange E Y t s) * E j * ThomGame.Analysis.matrixPartitionRange E Y t s +
        ThomGame.Analysis.matrixPartitionRange E Y t s * E j * (1 - ThomGame.Analysis.matrixPartitionRange E Y t s)))
    (s j)
ThomGame.Analysis.matrixPartitionRange_trace_derivative.{u_1, u_2, u_3} {ι : Type u_1} {κ : Type u_2} {μ : Type u_3}
  [Fintype ι] [Fintype κ] [Fintype μ] [DecidableEq ι] [DecidableEq κ] [DecidableEq μ] (r : ℕ) (E : μ → Matrix ι ι ℂ)
  (hE : ∀ (i : μ), IsStarProjection (E i)) (horth : ∀ (i j : μ), i ≠ j → E i * E j = 0) (Y : Matrix ι κ ℂ) (t : ℝ)
  (s : μ → ℝ) (j : μ) :
  HasDerivAt
    (fun a =>
      ThomGame.Analysis.matrixTraceReal r (E j * ThomGame.Analysis.matrixPartitionRange E Y t (Function.update s j a)))
    (2 * t * ThomGame.Analysis.matrixProjectionMixing r (E j) (ThomGame.Analysis.matrixPartitionRange E Y t s)) (s j)
ThomGame.Analysis.matrixPartitionRange_coordinate_interval.{u_1, u_2, u_3} {ι : Type u_1} {κ : Type u_2} {μ : Type u_3}
  [Fintype ι] [Fintype κ] [Fintype μ] [DecidableEq ι] [DecidableEq κ] [DecidableEq μ] (r : ℕ) (E : μ → Matrix ι ι ℂ)
  (hE : ∀ (i : μ), IsStarProjection (E i)) (horth : ∀ (i j : μ), i ≠ j → E i * E j = 0) (Y : Matrix ι κ ℂ) (t : ℝ)
  (s : μ → ℝ) (j : μ) :
  t *
      ∫ (a : ℝ) in -1..1,
        (1 - a ^ 2) *
          ThomGame.Analysis.matrixProjectionMixing r (E j)
            (ThomGame.Analysis.matrixPartitionRange E Y t (Function.update s j a)) =
    ∫ (a : ℝ) in -1..1,
      a *
        ThomGame.Analysis.matrixTraceReal r (E j * ThomGame.Analysis.matrixPartitionRange E Y t (Function.update s j a))
ThomGame.Analysis.matrixPartitionRange_defect.{u_1, u_2, u_3} {ι : Type u_1} {κ : Type u_2} {μ : Type u_3} [Fintype ι]
  [Fintype κ] [Fintype μ] [DecidableEq ι] [DecidableEq κ] (r : ℕ) (E : μ → Matrix ι ι ℂ)
  (hE : ∀ (i : μ), IsStarProjection (E i)) (horth : ∀ (i j : μ), i ≠ j → E i * E j = 0) (hsum : ∑ i, E i = 1)
  (Y : Matrix ι κ ℂ) (t : ℝ) (s : μ → ℝ) :
  ThomGame.Analysis.rectHSNorm r
        (ThomGame.Analysis.matrixPartitionRange E Y t s -
          ThomGame.Analysis.matrixBlockPinch E (ThomGame.Analysis.matrixPartitionRange E Y t s)) ^
      2 =
    ∑ i, ThomGame.Analysis.matrixProjectionMixing r (E i) (ThomGame.Analysis.matrixPartitionRange E Y t s)
ThomGame.Analysis.matrixPartitionPolarTilt_energy.{u_1, u_2, u_3} {ι : Type u_1} {κ : Type u_2} {μ : Type u_3}
  [Fintype ι] [Fintype κ] [Fintype μ] [DecidableEq ι] [DecidableEq κ] {h : ℕ} (r : ℕ)
  (U : Fin h → ↥(Matrix.unitaryGroup κ ℂ)) (V : Fin h → ↥(Matrix.unitaryGroup ι ℂ)) (E : μ → Matrix ι ι ℂ)
  (hE : ∀ (i : μ), IsStarProjection (E i)) (horth : ∀ (i j : μ), i ≠ j → E i * E j = 0) (hsum : ∑ i, E i = 1)
  (hcomm : ∀ (j : Fin h) (i : μ), ↑(V j) * E i = E i * ↑(V j)) {Y : Matrix ι κ ℂ}
  (hY : IsStarProjection (Y.conjTranspose * Y)) {t : ℝ} (ht : 0 ≤ t) (s : μ → ℝ) (hs : ∀ (i : μ), |s i| ≤ 1) :
  ThomGame.Analysis.matrixIntertwiningEnergy r U V
      (ThomGame.Analysis.matrixExponentialPolarTilt t (ThomGame.Analysis.matrixProjectionParameter E s) Y) ≤
    Real.exp (4 * t) * ThomGame.Analysis.matrixIntertwiningEnergy r U V Y
