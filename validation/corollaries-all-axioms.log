ThomGame.Pictures.PortGraph.numberedFullBoundary_sameCycle.{u_1, u_2} {R : Type u_1} {S : Type u_2}
  {P : ThomGame.InvolutionPresentation R S} {u v w : List S} (G : ThomGame.Pictures.PortGraph P u v)
  (H : ThomGame.Pictures.PortGraph P v w) (k l : ℕ)
  (a b : Subtype (ThomGame.Pictures.PortGraph.numberedSeamRemaining u v w l)) :
  (ThomGame.Pictures.MarkedReturn.perm (G.numberedPartialSeam H k)
          (ThomGame.Pictures.PortGraph.numberedSeamRemaining u v w l)).SameCycle
