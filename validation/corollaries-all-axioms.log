              A.hypergraph.Cycle → ThomGame.Pictures.PortGraph.Vertex G → Type :=
fun {R} {S} [DecidableEq R] [DecidableEq S] {A} {u v} G C x => { a // ThomGame.Pictures.Port.vertex ↑a = x }
