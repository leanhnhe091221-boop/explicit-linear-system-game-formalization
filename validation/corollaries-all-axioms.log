ThomGame.Pictures.PortGraph.SunMinimalState.rim_component_card_switch {n : ℕ} {b : Fin n → ZMod 2} (hn : 3 ≤ n)
  {w : List (Fin n ⊕ Fin n)} {G : ThomGame.Pictures.PortGraph (ThomGame.Pictures.sunPresentation n b) [] w}
  (h : G.SunMinimalState) (hw : ∀ z ∈ w, ∃ j, z = Sum.inl j) (s : G.SunSpoke) :
  ↑(Nat.card (s.switch.SunRimComponent hn ⋯ hw)) =
    ↑(Nat.card (G.SunRimComponent hn ⋯ hw)) +
      if
          ThomGame.Pictures.RibbonConnectivity.Connected (G.sunRimPairing hn).perm (G.sunRimVertexPairing hn ⋯ hw).perm
            (G.sunRimPort hn s.left true) (G.sunRimPort hn s.right true) then
        1
      else -1
