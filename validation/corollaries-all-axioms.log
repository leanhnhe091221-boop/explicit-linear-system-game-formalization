ThomGame.Analysis.exists_matrixPartition_ALT_lemma4_2.{u_1} {d h : ℕ} [NeZero d] [NeZero h] {μ : Type u_1} [Fintype μ]
  (U : Fin h → ↥(ThomGame.Analysis.UnitaryMatrix d)) (P : Option μ → ThomGame.Analysis.CMatrix d)
  (hP : ∀ (i : Option μ), IsStarProjection (P i)) (horth : Pairwise fun i j => P i * P j = 0) (hsum : ∑ i, P i = 1)
  (hred : ∀ (i : Option μ) (j : Fin h), Commute (P i) ↑(U j)) {κ : ℝ} (hκ : 0 < κ) (ξ : μ → ℝ) (hξ : ∀ (i : μ), 0 ≤ ξ i)
  (hexpand :
    ∀ (i : μ) (a : ThomGame.Analysis.CMatrix d),
      IsStarProjection a →
        a ≤ P (some i) →
          2 * Matrix.rank a ≤ Matrix.rank (P (some i)) →
            κ * ThomGame.Analysis.matrixTraceReal d a - ξ i ≤ ThomGame.Analysis.matrixCoordinateEnergy U a) :
  ∃ E T,
    (∀ (i : Option μ), IsStarProjection (E i)) ∧
      (Pairwise fun i j => E i * E j = 0) ∧
        ∑ i, E i = 1 ∧
          (∀ (i : μ), E (some i) ≤ P (some i)) ∧
            (∀ (i : Option μ) (j : Fin (h + h)), Commute (E i) ↑(T j)) ∧
              (∀ (j : Fin (h + h)), E none * ↑(T j) = E none) ∧
                ∑ i, ThomGame.Analysis.matrixCoordinateEnergy U (E (some i)) ≤ (∑ i, ξ i) / 8 ∧
                  ThomGame.Analysis.matrixTraceReal d (E none) ≤
                      ThomGame.Analysis.matrixTraceReal d (P none) + (16 * ∑ i, ξ i) / κ ∧
                    ∑ j, ThomGame.Analysis.hsNorm (↑(T j) - ↑(Fin.append U U j)) ^ 2 ≤
                        2 * ↑h * ∑ i, ξ i + 8 * ↑h * ThomGame.Analysis.matrixTraceReal d (E none) ∧
                      ∑ j, ThomGame.Analysis.hsNorm (↑(T j) - ↑(Fin.append U U j)) ^ 2 ≤
                          2 * ↑h * ∑ i, ξ i + 8 * ↑h * ThomGame.Analysis.matrixTraceReal d (P none) +
                            (128 * ↑h * ∑ i, ξ i) / κ ∧
                        ∀ (i : μ),
                          E (some i) ≠ 0 →
                            ∀ (X : ThomGame.Analysis.CMatrix d),
                              E (some i) * X = X →
                                X * E (some i) = X →
                                  κ ^ 2 / 256 *
                                      ThomGame.Analysis.hsNorm
                                          (X -
                                            (ThomGame.Analysis.normalizedTrace X /
                                                ThomGame.Analysis.normalizedTrace (E (some i))) •
                                              E (some i)) ^
                                        2 ≤
                                    ThomGame.Analysis.matrixCoordinateEnergy T X
