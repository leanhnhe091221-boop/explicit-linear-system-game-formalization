ThomGame.Analysis.exists_matrixUltraproduct_ALT_theorem4_3 (dims : ℕ → ℕ) {h : ℕ} [NeZero h]
  (U : (k : ℕ) → Fin h → ↥(ThomGame.Analysis.UnitaryMatrix (dims k))) (hd : ∀ (k : ℕ), 0 < dims k) (L : Ultrafilter ℕ)
  (hL : ↑L ≤ Filter.atTop) (κ : ℝ) (hgap : ThomGame.Analysis.MatrixMarkovSpectralGap dims U hd L κ) :
  ∃ T m E,
    (∀ (k : ℕ), m k ≤ 9 * dims k) ∧
      (∀ (k : ℕ) (i : Fin (m k)), IsStarProjection (E k i)) ∧
        (∀ (k : ℕ), Pairwise fun i j => E k i * E k j = 0) ∧
          (∀ (k : ℕ), ∑ i, E k i = 1) ∧
            (∀ (k : ℕ) (i : Fin (m k)) (j : Fin (h + h)), Commute (E k i) ↑(T k j)) ∧
              Filter.Tendsto (fun k => ∑ j, ThomGame.Analysis.hsNorm (↑(T k j) - ↑(Fin.append (U k) (U k) j)) ^ 2) (↑L)
                  (nhds 0) ∧
                ∀ (k : ℕ) (i : Fin (m k)),
                  E k i ≠ 0 →
                    ∀ (X : ThomGame.Analysis.CMatrix (dims k)),
                      E k i * X = X →
                        X * E k i = X →
                          κ ^ 2 / 2 ^ 28 *
                              ThomGame.Analysis.hsNorm
                                  (X -
                                    (ThomGame.Analysis.normalizedTrace X / ThomGame.Analysis.normalizedTrace (E k i)) •
                                      E k i) ^
                                2 ≤
                            ThomGame.Analysis.matrixCoordinateEnergy (T k) X
