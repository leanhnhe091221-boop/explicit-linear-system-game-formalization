ThomGame.Analysis.lazyHilbertAverage_energy.{u_1} {H : Type u_1} [NormedAddCommGroup H] [InnerProductSpace ℂ H] {h : ℕ}
  [NeZero h] (V : Fin h → H ≃ₗᵢ[ℂ] H) (ξ : H) :
  (inner ℂ ξ (ξ - (ThomGame.Analysis.lazyHilbertAverage V) ξ)).re =
    ThomGame.Analysis.lazyMarkovWeight h * ∑ j, ‖(V j) ξ - ξ‖ ^ 2
