ThomGame.Analysis.matrixSpectralCut_coarea {d h : ℕ} {X : ThomGame.Analysis.CMatrix d} [NeZero d] [NeZero h]
  (hX : Matrix.IsHermitian X) (U : Fin h → ↥(ThomGame.Analysis.UnitaryMatrix d)) (a b : ℝ) (hab : a ≤ b) :
  ∫ (s : ℝ) in a..b, ThomGame.Analysis.matrixCoordinateEnergy U (ThomGame.Analysis.matrixSpectralCut X s) ≤
    1 / 2 * √(ThomGame.Analysis.matrixCoordinateEnergy U X)
ThomGame.Analysis.matrixFamilySpectralCut_coarea.{u_1} {d h : ℕ} {ι : Type u_1} [Fintype ι] [NeZero h]
  (X : ι → ThomGame.Analysis.CMatrix d) (hX : ∀ (k : ι), Matrix.PosSemidef (X k))
  (U : Fin h → ↥(ThomGame.Analysis.UnitaryMatrix d)) (a b : ℝ) (ha : 0 < a) (hab : a ≤ b) :
